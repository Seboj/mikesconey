# Database
POSTGRES_USER=mikesconey
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=mikesconey
DATABASE_URL=postgresql://mikesconey:changeme_local_only@db:5432/mikesconey

# Session
SESSION_SECRET=replace-with-a-random-64-char-string

# Admin seed credentials
ADMIN_EMAIL=admin@mikesconey.com
ADMIN_PASSWORD=changeme

# API
API_PORT=3000
NODE_ENV=development

# AWS / S3 (required for gallery image uploads)
AWS_REGION=us-east-1
S3_BUCKET_NAME=mikesconeyisland-gallery
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Site mode ("live" or "coming_soon")
SITE_MODE=live

# Production config (optional in dev)
CORS_ORIGINS=https://www.mikesconeyisland.com,https://mikesconeyisland.com,https://test.mikesconeyisland.com
COOKIE_DOMAIN=.mikesconeyisland.com
SITE_URL=https://www.mikesconeyisland.com
