---
import { aboutReviews, aboutOverallRating, aboutReviewCount } from "../../data/reviews";

function getStars(count: number): number[] {
  return Array.from({ length: count }, (_, i) => i);
}
---

<section class="py-16 md:py-20 px-4 md:px-8 bg-brand-accent/40 bg-texture-warm">
  <div class="mx-auto max-w-5xl">
    <!-- Section header -->
    <div class="text-center mb-10">
      <div class="w-12 h-1 bg-brand-primary mx-auto mb-4 rounded-full"></div>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-text-heading mb-4">
        What Our Customers Say
      </h2>

      <!-- Overall Google rating badge -->
      <div class="inline-flex items-center gap-3 bg-white rounded-full px-5 py-2.5 shadow-sm border border-brand-divider/50">
        <span class="font-bold text-brand-text-heading text-sm">Google</span>
        <div class="flex items-center gap-0.5">
          {
            getStars(5).map(() => (
              <svg
                class="w-4 h-4 text-brand-secondary"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))
          }
        </div>
        <span class="font-bold text-brand-text-heading">{aboutOverallRating}</span>
        <span class="text-brand-text-muted text-sm">({aboutReviewCount} reviews)</span>
      </div>
    </div>

    <!-- Reviews grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        aboutReviews.map((review) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-brand-divider/50">
            {/* Opening quote mark */}
            <span class="text-4xl text-brand-primary/20 font-serif leading-none block mb-2">
              &ldquo;
            </span>

            {/* Quote text */}
            <p class="text-brand-text-body text-sm md:text-base leading-relaxed mb-4">
              {review.text}
            </p>

            {/* Star rating */}
            <div class="flex items-center gap-0.5 mb-2">
              {getStars(review.rating).map(() => (
                <svg
                  class="w-4 h-4 text-brand-secondary"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            {/* Author */}
            <p class="text-brand-text-muted text-sm font-medium">
              &mdash; {review.author}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Google reviews link -->
    <div class="text-center mt-8">
      <a
        href="#"
        class="text-brand-text-muted text-sm hover:text-brand-primary transition-colors"
      >
        See all reviews on Google &rarr;
      </a>
    </div>
  </div>
</section>
