---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact">
  <section class="px-4 md:px-8 lg:px-16 py-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-brand-text-heading text-center mb-4">
        Contact Us
      </h1>
      <p class="text-center text-brand-text-muted mb-12">
        We'd love to hear from you
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Address and phone -->
        <div class="bg-brand-accent/50 rounded-lg p-6">
          <h2 class="font-heading text-xl font-bold text-brand-text-heading mb-4">
            Visit Us
          </h2>
          <address class="not-italic text-brand-text-body space-y-2">
            <p>{site.address.street}</p>
            <p>{site.address.city}, {site.address.state} {site.address.zip}</p>
          </address>

          <div class="mt-4">
            <a
              href={site.phone.tel}
              class="inline-flex items-center gap-2 text-brand-primary hover:text-brand-primary-light font-medium transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              {site.phone.display}
            </a>
          </div>

          <div class="mt-4">
            <a
              href={site.maps.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-brand-primary hover:text-brand-primary-light font-medium transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
              </svg>
              Get Directions
            </a>
          </div>
        </div>

        <!-- Hours -->
        <div class="bg-brand-accent/50 rounded-lg p-6">
          <h2 class="font-heading text-xl font-bold text-brand-text-heading mb-4">
            Hours
          </h2>
          <ul class="text-brand-text-body space-y-2">
            {
              site.hours.map((h) => (
                <li class="flex justify-between">
                  <span class="font-medium">{h.day}</span>
                  <span class="text-brand-text-muted">
                    {h.closed ? "Closed" : `${h.open} – ${h.close}`}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Map placeholder -->
      <div class="mt-8 bg-brand-accent/30 border-2 border-brand-divider rounded-lg p-8 text-center">
        <p class="text-brand-text-muted">Map coming soon</p>
      </div>
    </div>
  </section>
</BaseLayout>
