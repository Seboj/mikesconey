---
import type { SiteInfoContent } from "../../../../shared/types";

interface Props {
  site: SiteInfoContent;
}

const { site } = Astro.props;
---

<section class="bg-brand-accent bg-texture-warm py-16 md:py-24 px-4 md:px-8">
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-sm font-bold tracking-widest text-brand-primary uppercase">
      Our Story
    </p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-brand-text-heading mt-4 mb-4">
      Welcome to {site.name}
    </h1>
    <p class="text-lg text-brand-text-muted">
      Serving Holly, Michigan {site.since.toLowerCase().replace("since ", "since ")}
    </p>
  </div>
</section>
