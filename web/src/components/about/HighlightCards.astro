---
const highlights = [
  {
    title: "Classic Coneys",
    description:
      "Our coney dogs are smothered in homemade chili sauce, diced onions, and yellow mustard. It's the recipe that put us on the map.",
    icon: "coney",
  },
  {
    title: "Homestyle Breakfast",
    description:
      "From fluffy pancakes to build-your-own omelets, breakfast at Mike's is the real deal. Served all day, because good mornings shouldn't have a deadline.",
    icon: "breakfast",
  },
  {
    title: "Friendly Faces",
    description:
      "Walk in a stranger, leave as a regular. Our crew knows your name, your order, and probably your kids' names too.",
    icon: "people",
  },
];
---

<section class="py-16 md:py-20 px-4 md:px-8 bg-brand-light">
  <div class="mx-auto max-w-4xl">
    <!-- Section header -->
    <div class="text-center mb-10">
      <div class="w-12 h-1 bg-brand-primary mx-auto mb-4 rounded-full"></div>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-text-heading">
        What Brings People Back
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mt-10">
      {
        highlights.map((item) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-brand-divider/50 text-center">
            {/* Icon */}
            <div class="flex items-center justify-center w-12 h-12 mx-auto rounded-full bg-brand-accent">
              {item.icon === "coney" && (
                <svg
                  class="w-6 h-6 text-brand-primary"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75-1.5.75a3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0L3 16.5m18-12.75-1.5.75a3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0L3 4.5"
                  />
                </svg>
              )}
              {item.icon === "breakfast" && (
                <svg
                  class="w-6 h-6 text-brand-primary"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                  />
                </svg>
              )}
              {item.icon === "people" && (
                <svg
                  class="w-6 h-6 text-brand-primary"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
                  />
                </svg>
              )}
            </div>

            <h3 class="font-heading font-bold text-lg text-brand-text-heading mt-4">
              {item.title}
            </h3>
            <p class="text-brand-text-body text-sm mt-2 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
