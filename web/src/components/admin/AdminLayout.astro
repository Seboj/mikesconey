---
import BaseHead from "../BaseHead.astro";

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage } = Astro.props;

// Check auth by calling the API
const apiUrl = process.env.API_URL || "http://localhost:3000";

let user: { id: string; email: string; name: string } | null = null;

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  const res = await fetch(`${apiUrl}/api/auth/me`, {
    headers: { cookie },
  });
  if (res.ok) {
    user = await res.json();
  }
} catch {
  // Auth check failed
}

if (!user) {
  return Astro.redirect("/admin/login");
}

const navItems = [
  { label: "Dashboard", href: "/admin/", icon: "dashboard" },
  { label: "Customers", href: "/admin/customers", icon: "customers" },
  { label: "Menu", href: "/admin/menu", icon: "menu" },
  { label: "Hours", href: "/admin/hours", icon: "hours" },
  { label: "FAQ", href: "/admin/faq", icon: "faq" },
  { label: "Gallery", href: "/admin/gallery", icon: "gallery" },
  { label: "Reviews", href: "/admin/reviews", icon: "reviews" },
  { label: "Specials", href: "/admin/specials", icon: "specials" },
  { label: "Settings", href: "/admin/settings", icon: "settings" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | Admin`} description="Admin Dashboard" />
  </head>
  <body class="min-h-screen flex bg-stone-100">
    <!-- Sidebar -->
    <aside class="hidden md:flex md:w-64 flex-col bg-brand-dark-deeper min-h-screen">
      <div class="px-6 py-5 border-b border-white/10">
        <a href="/admin/" class="flex items-center gap-2">
          <span class="font-display text-lg text-brand-primary">Mike's Coney</span>
        </a>
        <span class="text-xs text-brand-text-light/50 mt-1 block">Admin Dashboard</span>
      </div>

      <nav class="flex-1 px-3 py-4 space-y-1">
        {navItems.map((item) => {
          const isActive = activePage === item.icon;
          return (
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors",
                isActive
                  ? "bg-brand-primary text-white"
                  : "text-brand-text-light/70 hover:bg-white/5 hover:text-white",
              ]}
            >
              {item.icon === "dashboard" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              )}
              {item.icon === "customers" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              )}
              {item.icon === "menu" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {item.icon === "hours" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {item.icon === "faq" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {item.icon === "gallery" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              )}
              {item.icon === "reviews" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
              )}
              {item.icon === "specials" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                </svg>
              )}
              {item.icon === "settings" && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- User info + logout -->
      <div class="px-3 py-4 border-t border-white/10">
        <div class="flex items-center gap-3 px-3 py-2">
          <div class="w-8 h-8 rounded-full bg-brand-primary flex items-center justify-center text-white text-sm font-bold">
            {user.name.charAt(0).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate">{user.name}</p>
            <p class="text-xs text-brand-text-light/50 truncate">{user.email}</p>
          </div>
        </div>
        <button
          id="logout-btn"
          class="mt-2 w-full flex items-center gap-2 px-3 py-2 text-sm text-brand-text-light/50 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Sign Out</span>
        </button>
      </div>
    </aside>

    <!-- Mobile header -->
    <div class="md:hidden fixed top-0 left-0 right-0 z-50 bg-brand-dark-deeper px-4 py-3 flex items-center justify-between">
      <span class="font-heading font-bold text-white">Admin</span>
      <button id="mobile-menu-btn" class="text-white p-1">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-h-screen md:ml-0">
      <main class="flex-1 p-4 md:p-8 mt-14 md:mt-0">
        <slot />
      </main>
    </div>

    <script>
      // Logout
      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });

      // Mobile menu toggle (simple approach)
      const mobileBtn = document.getElementById("mobile-menu-btn");
      mobileBtn?.addEventListener("click", () => {
        const sidebar = document.querySelector("aside");
        sidebar?.classList.toggle("hidden");
        sidebar?.classList.toggle("fixed");
        sidebar?.classList.toggle("inset-0");
        sidebar?.classList.toggle("z-50");
      });
    </script>
  </body>
</html>
