---
import type { ReviewsContent } from "../../../shared/types";

interface Props {
  reviews: ReviewsContent;
}

const { reviews } = Astro.props;

function getStars(count: number): number[] {
  return Array.from({ length: count }, (_, i) => i);
}
---

<section class="py-16 md:py-20 px-4 md:px-8 bg-brand-dark-deeper relative overflow-hidden">
  <!-- Ambient glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[100%] h-[50%] bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.04)_0%,transparent_70%)] pointer-events-none"></div>
  <!-- Grain -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <!-- Section header -->
    <div class="text-center mb-10">
      <span class="section-accent mx-auto mb-4"></span>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-cream mb-3">
        What Our Customers Say
      </h2>

      <!-- Overall rating -->
      <div class="flex items-center justify-center gap-2">
        <div class="flex items-center gap-0.5">
          {getStars(5).map(() => (
            <svg class="w-5 h-5 text-brand-secondary" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="font-bold text-brand-cream">{reviews.overallRating}</span>
        <span class="text-stone-500 text-sm">({reviews.reviewCount} reviews)</span>
      </div>
    </div>

    <!-- Reviews grid -->
    <div class="grid md:grid-cols-3 gap-6">
      {reviews.reviews.slice(0, 3).map((review) => (
        <div class="bg-brand-dark rounded-xl p-6 border border-stone-800 relative overflow-hidden">
          <!-- Subtle accent line at top -->
          <div class="absolute top-0 left-[15%] right-[15%] h-px bg-gradient-to-r from-transparent via-brand-secondary/30 to-transparent"></div>

          <!-- Stars -->
          <div class="flex items-center gap-0.5 mb-3">
            {getStars(review.rating).map(() => (
              <svg class="w-4 h-4 text-brand-secondary" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="text-stone-300 text-sm md:text-base leading-relaxed mb-4">
            &ldquo;{review.text}&rdquo;
          </p>

          <!-- Author -->
          <p class="text-brand-secondary text-sm font-semibold">
            &mdash; {review.author}
          </p>
        </div>
      ))}
    </div>

    <!-- Google reviews link -->
    <div class="text-center mt-8">
      <a
        href="#"
        class="text-stone-500 text-sm hover:text-brand-secondary transition-colors"
      >
        See all reviews on Google
      </a>
    </div>
  </div>
</section>
