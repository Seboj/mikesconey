---
interface Props {
  item: {
    name: string;
    description: string;
    price: string;
    tags: string[];
  };
}

const { item } = Astro.props;

const tagColors: Record<string, string> = {
  GF: "bg-green-900/20 text-green-700 border-green-800/20",
  V: "bg-emerald-900/20 text-emerald-700 border-emerald-800/20",
  Spicy: "bg-red-900/20 text-red-700 border-red-800/20",
};
---

<div class="group card-warm p-4 hover:border-brand-secondary/30 transition-all duration-200">
  <div class="flex justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h3 class="font-heading font-bold text-brand-text-heading">{item.name}</h3>
        {item.tags.length > 0 && item.tags.map((tag) => (
          <span class={`text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded border ${tagColors[tag] || "bg-stone-100 text-stone-600 border-stone-200"}`}>
            {tag}
          </span>
        ))}
      </div>
      <p class="text-sm text-brand-text-muted mt-1 leading-relaxed">{item.description}</p>
    </div>
    <div class="flex-shrink-0 font-heading font-bold text-brand-primary text-lg">
      {item.price}
    </div>
  </div>
</div>
