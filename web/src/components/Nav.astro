---
import type { SiteInfoContent } from "../../../shared/types";

interface Props {
  site: SiteInfoContent;
}

const { site } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Menu", href: "/menu/" },
  { label: "Gallery", href: "/gallery/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<!-- Skip navigation link -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-brand-primary focus:text-brand-text-light focus:px-4 focus:py-2 focus:rounded"
>
  Skip to content
</a>

<header class="sticky top-0 z-50 bg-brand-dark-deeper">
  <nav class="mx-auto max-w-7xl px-4 md:px-8" aria-label="Main navigation">
    <div class="flex h-16 items-center justify-between">
      <!-- Restaurant name in Permanent Marker -->
      <a
        href="/"
        class="font-display text-xl tracking-tight text-brand-primary hover:text-brand-primary-light transition-colors text-neon-red animate-flicker"
      >
        {site.name}
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:flex items-center gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "px-3 py-2 text-sm font-semibold tracking-wide uppercase rounded transition-all duration-200",
                isActive(link.href)
                  ? "text-brand-secondary text-neon-amber"
                  : "text-stone-400 hover:text-brand-cream hover:bg-white/5",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }

        <!-- Desktop phone number -->
        <a
          href={site.phone.tel}
          class="ml-4 inline-flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-brand-dark-deeper bg-brand-secondary rounded hover:bg-brand-secondary-light transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          {site.phone.display}
        </a>

        <!-- Social icons (desktop) -->
        <div class="flex items-center gap-1 ml-2 border-l border-stone-700 pl-3">
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-8 h-8 rounded text-stone-500 hover:text-brand-secondary transition-colors"
            aria-label="Follow us on Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-8 h-8 rounded text-stone-500 hover:text-brand-secondary transition-colors"
            aria-label="Follow us on Facebook"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Mobile hamburger button -->
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded text-stone-400 hover:text-brand-cream hover:bg-white/5 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Accent stripe — red to amber gradient -->
  <div class="h-1 bg-gradient-to-r from-brand-primary via-brand-primary to-brand-secondary"></div>

  <!-- Mobile slide-in menu -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 right-0 z-50 w-72 bg-brand-dark-deeper transform translate-x-full transition-transform duration-300 ease-in-out md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="flex items-center justify-between px-4 h-16 border-b border-stone-800">
      <span class="font-display text-brand-primary text-neon-red">
        {site.name}
      </span>
      <button
        id="menu-close"
        type="button"
        class="flex items-center justify-center w-11 h-11 rounded text-stone-400 hover:text-brand-cream hover:bg-white/5 transition-colors"
        aria-label="Close menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="flex flex-col px-4 py-4 gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "px-3 py-3 text-sm font-semibold uppercase tracking-wide rounded transition-colors",
              isActive(link.href)
                ? "text-brand-secondary bg-brand-secondary/10"
                : "text-stone-400 hover:text-brand-cream hover:bg-white/5",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <!-- Mobile phone number -->
      <div class="mt-4 pt-4 border-t border-stone-800">
        <a
          href={site.phone.tel}
          class="flex items-center gap-2 px-3 py-3 text-base font-bold text-brand-secondary hover:text-brand-secondary-light transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          {site.phone.display}
        </a>

        <!-- Social icons (mobile) -->
        <div class="flex items-center gap-3 px-3 mt-3">
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-stone-500 hover:text-brand-secondary transition-colors"
            aria-label="Follow us on Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            Instagram
          </a>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-stone-500 hover:text-brand-secondary transition-colors"
            aria-label="Follow us on Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile overlay -->
  <div
    id="mobile-overlay"
    class="fixed inset-0 z-40 bg-black/50 hidden md:hidden"
  >
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const close = document.getElementById("menu-close");
  const overlay = document.getElementById("mobile-overlay");

  function openMenu() {
    menu?.classList.remove("translate-x-full");
    overlay?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    menu?.classList.add("translate-x-full");
    overlay?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle?.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  close?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      !menu?.classList.contains("translate-x-full")
    ) {
      closeMenu();
    }
  });
</script>
