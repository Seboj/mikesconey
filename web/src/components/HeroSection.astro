---
import type { SiteInfoContent } from "../../../shared/types";

interface Props {
  site: SiteInfoContent;
}

const { site } = Astro.props;
---

<section class="relative w-full min-h-[60vh] md:min-h-[70vh] flex items-center justify-center overflow-hidden">
  <!-- Replace this SVG with <img> when real food photography arrives -->
  <div class="absolute inset-0 bg-brand-dark-deeper">
    <svg
      class="w-full h-full opacity-30"
      viewBox="0 0 800 600"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Warm abstract circles suggesting food/restaurant atmosphere -->
      <circle cx="200" cy="300" r="180" fill="#B91C1C" opacity="0.12" />
      <circle cx="600" cy="200" r="220" fill="#B91C1C" opacity="0.08" />
      <circle cx="400" cy="500" r="150" fill="#CA8A04" opacity="0.10" />
      <circle cx="700" cy="450" r="120" fill="#CA8A04" opacity="0.08" />
      <circle cx="100" cy="100" r="80" fill="#CA8A04" opacity="0.06" />

      <!-- Wavy decorative lines -->
      <path
        d="M0 400 Q200 350 400 400 T800 400"
        fill="none"
        stroke="#CA8A04"
        stroke-width="2"
        opacity="0.10"
      />
      <path
        d="M0 450 Q200 400 400 450 T800 450"
        fill="none"
        stroke="#B91C1C"
        stroke-width="1.5"
        opacity="0.08"
      />

      <!-- Scattered dots for texture -->
      <circle cx="150" cy="150" r="3" fill="#FEF3C7" opacity="0.15" />
      <circle cx="350" cy="100" r="2" fill="#FEF3C7" opacity="0.12" />
      <circle cx="550" cy="180" r="3" fill="#FEF3C7" opacity="0.10" />
      <circle cx="650" cy="350" r="2" fill="#FEF3C7" opacity="0.12" />
      <circle cx="250" cy="450" r="3" fill="#FEF3C7" opacity="0.10" />
      <circle cx="450" cy="280" r="2" fill="#FEF3C7" opacity="0.15" />
      <circle cx="100" cy="500" r="2" fill="#FEF3C7" opacity="0.08" />
      <circle cx="750" cy="150" r="3" fill="#FEF3C7" opacity="0.10" />
    </svg>
  </div>

  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand-dark-deeper/60 via-brand-dark/40 to-brand-dark-deeper/70"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 md:px-8 py-16">
    <p class="text-brand-secondary text-sm font-medium tracking-wider uppercase mb-3">
      {site.since}
    </p>
    <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-brand-text-light mb-4">
      {site.name}
    </h1>
    <p class="text-lg md:text-xl text-brand-text-light/90 mb-8 max-w-xl mx-auto">
      {site.tagline}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/menu/"
        class="inline-block px-8 py-3 bg-brand-primary text-brand-text-light font-medium rounded hover:bg-brand-primary-light transition-colors"
      >
        View Our Menu
      </a>
      <a
        href={site.phone.tel}
        class="inline-flex items-center gap-2 px-8 py-3 border-2 border-brand-text-light/30 text-brand-text-light font-medium rounded hover:bg-brand-text-light/10 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
        Call {site.phone.display}
      </a>
    </div>
  </div>
</section>
