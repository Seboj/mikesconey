---
import type { SiteInfoContent } from "../../../shared/types";

interface Props {
  site: SiteInfoContent;
}

const { site } = Astro.props;
---

<section class="relative w-full min-h-[60vh] md:min-h-[70vh] flex items-center justify-center overflow-hidden bg-brand-dark-deeper">
  <!-- Warm ambient glow -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[120%] h-[60%] bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.07)_0%,transparent_70%)]"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[100%] h-[40%] bg-[radial-gradient(ellipse_at_center,rgba(185,28,28,0.05)_0%,transparent_70%)]"></div>
  </div>

  <!-- Grain texture -->
  <div class="absolute inset-0 opacity-[0.035] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 md:px-8 py-20 md:py-28">
    <p class="text-xs font-bold tracking-[0.2em] uppercase text-brand-secondary mb-4 fade-up">
      {site.since}
    </p>
    <h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-brand-primary mb-4 text-neon-red animate-flicker fade-up fade-up-delay-1">
      {site.name}
    </h1>
    <div class="divider-amber w-16 mx-auto mb-5 fade-up fade-up-delay-2"></div>
    <p class="text-lg md:text-xl text-brand-cream-dim mb-10 max-w-xl mx-auto fade-up fade-up-delay-3">
      {site.tagline}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-up fade-up-delay-4">
      <a
        href="/menu/"
        class="inline-block px-8 py-3.5 bg-brand-primary text-white font-bold rounded hover:bg-brand-primary-light transition-colors text-sm uppercase tracking-wider"
      >
        View Our Menu
      </a>
      <a
        href={site.phone.tel}
        class="inline-flex items-center gap-2 px-8 py-3.5 border border-stone-700 text-brand-cream font-medium rounded hover:border-brand-secondary hover:text-brand-secondary transition-all text-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
        Call {site.phone.display}
      </a>
    </div>
  </div>
</section>
