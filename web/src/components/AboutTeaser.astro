---
import type { SiteInfoContent } from "../../../shared/types";

interface Props {
  site: SiteInfoContent;
}

const { site } = Astro.props;
---

<section class="py-16 md:py-20 px-4 md:px-8 bg-white">
  <div class="mx-auto max-w-4xl">
    <div class="grid md:grid-cols-5 gap-8 md:gap-12 items-center">
      <!-- Text content -->
      <div class="md:col-span-3">
        <div class="w-12 h-1 bg-brand-primary rounded-full mb-4"></div>
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-text-heading mb-6">
          A Holly Tradition
        </h2>
        <p class="text-brand-text-body text-base md:text-lg leading-relaxed mb-4">
          {site.name} has been a Holly, Michigan staple since 1995. From our
          signature coney dogs loaded with homemade chili to fluffy breakfast
          plates that get you going — we're the kind of place where regulars
          wave from their booth and newcomers feel right at home.
        </p>
        <p class="text-brand-text-body text-base md:text-lg leading-relaxed mb-6">
          Stop in, grab a seat at the counter, and see what keeps the
          neighborhood coming back.
        </p>
        <a
          href="/about/"
          class="inline-flex items-center gap-2 text-brand-primary font-medium hover:text-brand-primary-light transition-colors"
        >
          Read Our Story
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Decorative accent block -->
      <div class="md:col-span-2">
        <div class="bg-brand-accent rounded-2xl p-8 md:p-10 bg-texture-warm text-center">
          <svg class="w-16 h-16 mx-auto text-brand-primary/20 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <p class="font-heading text-brand-secondary text-lg font-bold mb-2">
            {site.since}
          </p>
          <p class="text-brand-text-muted text-sm">
            {site.address.city}, {site.address.state}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
