---
---

<section class="bg-brand-dark relative overflow-hidden py-14 md:py-16">
  <!-- Subtle warm glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-px bg-gradient-to-r from-transparent via-brand-secondary/30 to-transparent"></div>
  <!-- Grain -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <span class="section-accent mx-auto mb-5"></span>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-cream mb-3">
        Get Exclusive Deals &amp; Specials
      </h2>
      <p class="text-stone-400 mb-8">
        Be the first to know about our weekly specials, new menu items, and exclusive offers for our loyal customers.
      </p>

      <form id="signup-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="signup-name" class="sr-only">First Name</label>
            <input
              type="text"
              id="signup-name"
              name="firstName"
              placeholder="First Name"
              required
              class="w-full px-4 py-3 rounded-lg border border-stone-700 bg-brand-dark-deeper text-brand-cream placeholder:text-stone-600 focus:outline-none focus:ring-2 focus:ring-brand-primary/40 focus:border-brand-primary transition-colors"
            />
          </div>
          <div>
            <label for="signup-email" class="sr-only">Email</label>
            <input
              type="email"
              id="signup-email"
              name="email"
              placeholder="Email Address"
              required
              class="w-full px-4 py-3 rounded-lg border border-stone-700 bg-brand-dark-deeper text-brand-cream placeholder:text-stone-600 focus:outline-none focus:ring-2 focus:ring-brand-primary/40 focus:border-brand-primary transition-colors"
            />
          </div>
        </div>

        <div>
          <label for="signup-phone" class="sr-only">Phone (optional — for text deals)</label>
          <input
            type="tel"
            id="signup-phone"
            name="phone"
            placeholder="Phone Number (optional — for text deals)"
            class="w-full sm:w-1/2 mx-auto block px-4 py-3 rounded-lg border border-stone-700 bg-brand-dark-deeper text-brand-cream placeholder:text-stone-600 focus:outline-none focus:ring-2 focus:ring-brand-primary/40 focus:border-brand-primary transition-colors"
          />
        </div>

        <!-- Email consent (always shown) -->
        <div class="flex items-start justify-center gap-2 text-sm text-stone-400">
          <input
            type="checkbox"
            id="signup-consent"
            name="consent"
            required
            class="mt-0.5 rounded border-stone-600 bg-brand-dark-deeper text-brand-primary focus:ring-brand-primary/30"
          />
          <label for="signup-consent">
            I agree to receive deals and specials via email. Unsubscribe anytime.
          </label>
        </div>

        <!-- SMS consent (shown when phone is entered) -->
        <div id="sms-consent-row" class="hidden flex items-start justify-center gap-2 text-sm text-stone-400">
          <input
            type="checkbox"
            id="signup-sms-consent"
            name="smsConsent"
            class="mt-0.5 rounded border-stone-600 bg-brand-dark-deeper text-brand-primary focus:ring-brand-primary/30"
          />
          <label for="signup-sms-consent" class="text-left max-w-md">
            I agree to receive recurring automated promotional text messages (SMS/MMS) from Mike's Coney Island at the number provided. Consent is not a condition of purchase. Msg &amp; data rates may apply. Msg frequency varies (up to 8/mo). Reply STOP to cancel, HELP for help.
            <a href="/privacy/" class="text-brand-secondary hover:underline">Privacy Policy</a> &amp;
            <a href="/terms/#sms-terms" class="text-brand-secondary hover:underline">Terms</a>.
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-primary text-white font-bold rounded-lg hover:bg-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-primary/50 focus:ring-offset-2 focus:ring-offset-brand-dark disabled:opacity-50 disabled:cursor-not-allowed uppercase tracking-wider text-sm"
        >
          <span id="signup-btn-text">Sign Me Up</span>
          <svg id="signup-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <!-- Success state -->
      <div id="signup-success" class="hidden">
        <div class="inline-flex items-center gap-2 px-6 py-3 bg-green-900/30 text-green-400 rounded-lg border border-green-800/50">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
          <span class="font-medium">You're in! Watch your inbox for exclusive deals.</span>
        </div>
      </div>

      <!-- Error state -->
      <p id="signup-error" class="hidden mt-4 text-sm text-red-400 font-medium"></p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement;
  const successEl = document.getElementById("signup-success")!;
  const errorEl = document.getElementById("signup-error")!;
  const btnText = document.getElementById("signup-btn-text")!;
  const spinner = document.getElementById("signup-spinner")!;
  const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement;
  const phoneInput = document.getElementById("signup-phone") as HTMLInputElement;
  const smsConsentRow = document.getElementById("sms-consent-row")!;
  const smsConsentBox = document.getElementById("signup-sms-consent") as HTMLInputElement;

  // Show/hide SMS consent when phone number is entered
  phoneInput.addEventListener("input", () => {
    const hasPhone = phoneInput.value.trim().length > 0;
    if (hasPhone) {
      smsConsentRow.classList.remove("hidden");
      smsConsentRow.classList.add("flex");
    } else {
      smsConsentRow.classList.add("hidden");
      smsConsentRow.classList.remove("flex");
      smsConsentBox.checked = false;
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    errorEl.textContent = "";
    submitBtn.disabled = true;
    btnText.textContent = "Signing up...";
    spinner.classList.remove("hidden");

    const formData = new FormData(form);
    const phone = (formData.get("phone") as string)?.trim() || "";
    const smsConsent = smsConsentBox.checked;

    const body = {
      firstName: formData.get("firstName"),
      email: formData.get("email"),
      phone: phone || undefined,
      optInEmail: true,
      optInSms: phone && smsConsent,
    };

    try {
      const res = await fetch("/api/customers", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        form.classList.add("hidden");
        successEl.classList.remove("hidden");
      } else {
        const data = await res.json();
        errorEl.textContent = data.error || "Something went wrong. Please try again.";
        errorEl.classList.remove("hidden");
      }
    } catch {
      errorEl.textContent = "Network error. Please try again.";
      errorEl.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = "Sign Me Up";
      spinner.classList.add("hidden");
    }
  });
</script>
