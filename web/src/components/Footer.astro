---
import type { SiteInfoContent, HoursContent } from "../../../shared/types";

interface Props {
  site: SiteInfoContent;
  hours: HoursContent;
}

const { site, hours } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark-deeper text-stone-400">
  <!-- Gradient stripe at top -->
  <div class="h-1 bg-gradient-to-r from-brand-primary via-brand-secondary to-brand-primary"></div>

  <div class="mx-auto max-w-7xl px-4 md:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
      <!-- Column 1: Location & Hours -->
      <div>
        <h3 class="font-display text-brand-primary text-lg mb-5 text-neon-red">
          {site.name}
        </h3>
        <address class="not-italic text-sm space-y-1 mb-6">
          <p class="text-stone-400">{site.address.street}</p>
          <p class="text-stone-400">
            {site.address.city}, {site.address.state} {site.address.zip}
          </p>
        </address>

        <h4 class="text-xs font-bold tracking-[0.18em] uppercase text-brand-secondary mb-3">
          Hours
        </h4>
        <ul class="text-sm space-y-1.5">
          {
            hours.map((h) => (
              <li class="flex justify-between max-w-[220px]">
                <span class="text-stone-500">{h.day}</span>
                <span class={h.closed ? "text-brand-primary font-medium" : "text-stone-300 font-medium"}>
                  {h.closed ? "Closed" : `${h.open} \u2013 ${h.close}`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h4 class="text-xs font-bold tracking-[0.18em] uppercase text-brand-secondary mb-5">
          Quick Links
        </h4>
        <nav aria-label="Footer navigation">
          <ul class="space-y-1">
            {
              [
                { label: "Home", href: "/" },
                { label: "Menu", href: "/menu/" },
                { label: "Specials", href: "/specials/" },
                { label: "Gallery", href: "/gallery/" },
                { label: "About", href: "/about/" },
                { label: "Contact", href: "/contact/" },
              ].map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-block py-2 text-sm text-stone-400 hover:text-brand-cream transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <!-- Column 3: Connect -->
      <div>
        <h4 class="text-xs font-bold tracking-[0.18em] uppercase text-brand-secondary mb-5">
          Connect
        </h4>

        <!-- Phone -->
        <a
          href={site.phone.tel}
          class="flex items-center gap-2.5 py-2.5 text-sm font-semibold text-brand-cream hover:text-brand-secondary transition-colors"
        >
          <svg
            class="w-5 h-5 text-brand-secondary"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          {site.phone.display}
        </a>

        <!-- Instagram -->
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2.5 py-2.5 text-sm text-stone-400 hover:text-brand-secondary transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
            ></path>
          </svg>
          Instagram
        </a>

        <!-- Facebook -->
        <a
          href={site.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2.5 py-2.5 text-sm text-stone-400 hover:text-brand-secondary transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path>
          </svg>
          Facebook
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-stone-800">
    <div
      class="mx-auto max-w-7xl px-4 md:px-8 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-stone-600"
    >
      <span>{site.name} &middot; Holly, Michigan</span>
      <div class="flex items-center gap-3">
        <a href="/privacy/" class="hover:text-stone-400 transition-colors">Privacy Policy</a>
        <span>&middot;</span>
        <a href="/terms/" class="hover:text-stone-400 transition-colors">Terms &amp; Conditions</a>
        <span>&middot;</span>
        <span>&copy; {currentYear} {site.name}</span>
      </div>
    </div>
  </div>
</footer>
