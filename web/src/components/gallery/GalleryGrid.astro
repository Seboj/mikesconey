---
import type { GalleryContent } from "../../../../shared/types";

interface Props {
  images: GalleryContent;
}

const { images } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
  {
    images.map((image, index) => (
      <button
        type="button"
        class="group aspect-[4/3] overflow-hidden rounded-xl cursor-pointer relative focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 card-warm"
        data-gallery-item
        data-index={index}
        data-src={image.src}
        data-alt={image.alt}
        data-caption={image.caption || ""}
        aria-label={`View ${image.alt}`}
      >
        <img
          src={image.src}
          alt={image.alt}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading={index < 6 ? "eager" : "lazy"}
          width="400"
          height="300"
        />
        {image.caption && (
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-brand-dark-deeper/80 to-transparent p-4 opacity-0 group-hover:opacity-100 transition-opacity">
            <p class="text-sm text-brand-cream font-medium">{image.caption}</p>
          </div>
        )}
      </button>
    ))
  }
</div>
