---
import type { HoursContent } from "../../../shared/types";

interface Props {
  hours: HoursContent;
}

const { hours } = Astro.props;
---

<section class="py-14 md:py-20 px-4 md:px-8">
  <div class="mx-auto max-w-2xl">
    <div class="text-center mb-8">
      <span class="section-accent mx-auto mb-4"></span>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-text-heading">
        Hours of Operation
      </h2>
    </div>

    <div class="card-warm p-6 md:p-8">
      {hours.map((h) => (
        <div
          class="hours-row flex justify-between items-center py-3 border-b border-brand-divider/50 last:border-b-0"
          data-day={h.day}
        >
          <span class="hours-day font-medium text-brand-text-body text-sm">
            {h.day}
          </span>
          {h.closed ? (
            <span class="hours-time text-brand-primary font-semibold text-sm">
              Closed
            </span>
          ) : (
            <span class="hours-time text-brand-text-muted text-sm">
              {h.open} &ndash; {h.close}
            </span>
          )}
        </div>
      ))}
    </div>

    <p class="text-sm text-brand-text-muted text-center mt-4">
      Hours may vary on holidays. Call to confirm.
    </p>
  </div>
</section>

<script>
  const days = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
  const today = days[new Date().getDay()];
  document.querySelectorAll('.hours-row').forEach(row => {
    if (row instanceof HTMLElement && row.dataset.day === today) {
      row.classList.add('bg-brand-secondary/5', 'rounded-lg', 'px-3', '-mx-3');
      const daySpan = row.querySelector('.hours-day');
      if (daySpan) {
        daySpan.classList.add('text-brand-primary', 'font-bold');
      }
      const timeSpan = row.querySelector('.hours-time');
      if (timeSpan) {
        timeSpan.classList.add('text-brand-primary', 'font-semibold');
      }
    }
  });
</script>
