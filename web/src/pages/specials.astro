---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent, SpecialsContent } from "../../../shared/types";

const [siteInfo, hours, specials] = await Promise.all([
  fetchContent<SiteInfoContent>("site_info"),
  fetchContent<HoursContent>("hours"),
  fetchContent<SpecialsContent>("specials").catch(() => [] as SpecialsContent),
]);

const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const todayName = days[new Date().getDay()];

// Order specials starting from today
const todayIndex = days.indexOf(todayName);
const orderedDays = [...days.slice(todayIndex), ...days.slice(0, todayIndex)];
const activeSpecials = orderedDays
  .map((day) => specials.find((s) => s.day === day && s.active))
  .filter(Boolean);
---

<BaseLayout title="Weekly Specials" siteInfo={siteInfo} hours={hours}>
  <!-- Page header -->
  <section class="bg-brand-dark-deeper relative overflow-hidden py-14 md:py-20">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[60%] bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.05)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 md:px-8 text-center">
      <h1 class="font-display text-3xl md:text-5xl text-brand-primary text-neon-red mb-3">
        Weekly Specials
      </h1>
      <div class="divider-amber w-16 mx-auto mb-4"></div>
      <p class="text-stone-400 text-lg max-w-2xl mx-auto">
        Something special every day of the week — swing by and save!
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 md:px-8 py-8 md:py-12">
    {activeSpecials.length === 0 ? (
      <p class="text-center text-stone-500 text-lg py-12">No specials this week — check back soon!</p>
    ) : (
      <div class="space-y-4">
        {activeSpecials.map((special) => {
          const isToday = special!.day === todayName;
          return (
            <div class:list={[
              "relative rounded-xl border overflow-hidden transition-all",
              isToday
                ? "bg-brand-dark border-brand-primary/30 ring-1 ring-brand-primary/20"
                : "bg-brand-dark border-stone-800",
            ]}>
              {isToday && (
                <div class="absolute top-0 left-[20%] right-[20%] h-px bg-gradient-to-r from-transparent via-brand-primary to-transparent"></div>
              )}
              <div class="px-6 py-5 md:px-8 md:py-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <!-- Day label -->
                <div class="flex-shrink-0 w-28">
                  <div class="flex flex-col">
                    {isToday && (
                      <span class="inline-flex items-center gap-1 text-brand-primary text-xs font-bold uppercase tracking-wider mb-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                        </svg>
                        Today
                      </span>
                    )}
                    <span class:list={[
                      "font-display text-lg",
                      isToday ? "text-brand-cream" : "text-stone-400",
                    ]}>
                      {special!.day}
                    </span>
                  </div>
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <h3 class:list={[
                    "font-display text-lg md:text-xl",
                    isToday ? "text-brand-cream" : "text-stone-300",
                  ]}>
                    {special!.title}
                  </h3>
                  <p class="text-stone-400 text-sm mt-1">
                    {special!.description}
                  </p>
                </div>

                <!-- Price badge -->
                {special!.price && (
                  <div class="flex-shrink-0">
                    <span class:list={[
                      "inline-block px-4 py-2 rounded font-bold text-lg",
                      isToday
                        ? "bg-brand-secondary text-brand-dark-deeper"
                        : "bg-stone-800 text-stone-300",
                    ]}>
                      {special!.price}
                    </span>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
