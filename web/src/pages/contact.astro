---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent, FaqContent } from "../../../shared/types";

const [siteInfo, hours, faqItems] = await Promise.all([
  fetchContent<SiteInfoContent>("site_info"),
  fetchContent<HoursContent>("hours"),
  fetchContent<FaqContent>("faq"),
]);
---

<BaseLayout title="Contact" siteInfo={siteInfo} hours={hours}>
  <!-- Page Header -->
  <section class="bg-brand-dark-deeper relative overflow-hidden py-14 md:py-20">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[60%] bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.05)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center px-4 md:px-8">
      <h1 class="font-display text-3xl md:text-5xl text-brand-primary text-neon-red mb-3">
        Find Us
      </h1>
      <div class="divider-amber w-16 mx-auto mb-4"></div>
      <p class="text-stone-400 text-lg">
        Stop by for a classic coney, a hearty breakfast, or your favorite
        comfort food.
      </p>
    </div>
  </section>

  <!-- Contact Info + Map -->
  <section class="px-4 md:px-8 lg:px-16 py-12 md:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <!-- Left Column: Contact Details -->
        <div class="space-y-6">
          <!-- Visit Us Card -->
          <div class="card-warm p-6">
            <h2 class="font-heading text-xl font-bold text-brand-text-heading mb-4">
              Visit Us
            </h2>
            <address class="not-italic text-brand-text-body space-y-1 mb-4">
              <p>{siteInfo.address.street}</p>
              <p>
                {siteInfo.address.city}, {siteInfo.address.state}{" "}
                {siteInfo.address.zip}
              </p>
            </address>

            <a
              href={siteInfo.maps.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-brand-primary hover:text-brand-primary-light font-bold transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
              </svg>
              Get Directions
            </a>

            <div class="mt-4">
              <a
                href={siteInfo.phone.tel}
                class="inline-flex items-center gap-2 text-brand-primary hover:text-brand-primary-light font-bold text-lg transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
                {siteInfo.phone.display}
              </a>
            </div>
          </div>

          <!-- Hours Card -->
          <div class="card-warm p-6">
            <h2 class="font-heading text-xl font-bold text-brand-text-heading mb-4">
              Hours
            </h2>
            {
              hours.map((h) => (
                <div
                  class="contact-hours-row flex justify-between items-center py-2 border-b border-brand-divider/30 last:border-b-0 text-sm"
                  data-day={h.day}
                >
                  <span class="contact-hours-day font-medium text-brand-text-body">
                    {h.day}
                  </span>
                  {h.closed ? (
                    <span class="contact-hours-time text-brand-primary font-semibold">
                      Closed
                    </span>
                  ) : (
                    <span class="contact-hours-time text-brand-text-muted">
                      {h.open} &ndash; {h.close}
                    </span>
                  )}
                </div>
              ))
            }
            <p class="text-sm text-brand-text-muted mt-3">
              Hours may vary on holidays. Call to confirm.
            </p>
          </div>
        </div>

        <!-- Right Column: Google Map -->
        <div
          class="rounded-xl overflow-hidden card-warm h-full min-h-[350px] md:min-h-[450px]"
        >
          <iframe
            src={siteInfo.maps.embedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height: 350px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mike's Coney Island location on Google Maps"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="px-4 md:px-8 lg:px-16 py-12 md:py-16 bg-brand-dark-deeper relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>

    <div class="relative z-10 mx-auto max-w-3xl">
      <span class="section-accent mx-auto mb-4"></span>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-cream text-center mb-8">
        Frequently Asked Questions
      </h2>
      <FaqAccordion faqItems={faqItems} />
    </div>
  </section>
</BaseLayout>

<script>
  const days = [
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
  ];
  const today = days[new Date().getDay()];
  document.querySelectorAll(".contact-hours-row").forEach((row) => {
    if (row instanceof HTMLElement && row.dataset.day === today) {
      row.classList.add("bg-brand-secondary/5", "rounded-lg", "px-3", "-mx-3");
      const daySpan = row.querySelector(".contact-hours-day");
      if (daySpan) {
        daySpan.classList.add("text-brand-primary", "font-bold");
      }
      const timeSpan = row.querySelector(".contact-hours-time");
      if (timeSpan) {
        timeSpan.classList.add("text-brand-primary", "font-semibold");
      }
    }
  });
</script>
