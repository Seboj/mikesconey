---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent } from "../../../shared/types";

const [siteInfo, hours] = await Promise.all([
  fetchContent<SiteInfoContent>("site_info"),
  fetchContent<HoursContent>("hours"),
]);

const lastUpdated = "March 6, 2026";
---

<BaseLayout title="Terms & Conditions" siteInfo={siteInfo} hours={hours}>
  <section class="bg-brand-dark-deeper relative overflow-hidden py-14 md:py-20">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 md:px-8 text-center">
      <h1 class="font-display text-3xl md:text-5xl text-brand-primary text-neon-red mb-3">
        Terms &amp; Conditions
      </h1>
      <div class="divider-amber w-16 mx-auto mb-4"></div>
      <p class="text-stone-400 text-sm">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 md:px-8 py-8 md:py-12">
    <div class="prose-legal space-y-8 text-stone-300 text-sm leading-relaxed">

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Agreement to Terms</h2>
        <p>
          By accessing or using the Mike's Coney Island website
          (<a href="https://www.mikesconeyisland.com" class="text-brand-secondary hover:underline">www.mikesconeyisland.com</a>)
          or by opting in to our text message program, you agree to be bound by these Terms &amp;
          Conditions. If you do not agree, please do not use our website or services.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Use of Website</h2>
        <p>You agree to use this website only for lawful purposes. You may not:</p>
        <ul class="list-disc pl-5 space-y-2 text-stone-400 mt-3">
          <li>Use the site in any way that violates applicable laws or regulations</li>
          <li>Attempt to gain unauthorized access to any part of the website or its systems</li>
          <li>Use automated tools to scrape or collect data from the website</li>
          <li>Transmit harmful code or interfere with the website's operation</li>
        </ul>
      </section>

      <section id="sms-terms">
        <h2 class="font-display text-xl text-brand-cream mb-3">SMS/Text Message Terms</h2>
        <p class="mb-4">
          By opting in to Mike's Coney Island text messages, you agree to the following terms:
        </p>

        <div class="bg-brand-dark rounded-lg border border-stone-800 p-5 space-y-4">
          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Consent</h3>
            <p class="text-stone-400">
              By providing your mobile phone number and opting in, you expressly consent to receive
              recurring automated marketing and informational text messages (SMS and MMS) from
              Mike's Coney Island, including promotions, specials, updates, and other communications.
              Consent is not a condition of purchase. You can opt in or opt out at any time.
            </p>
          </div>

          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Message Frequency</h3>
            <p class="text-stone-400">
              Message frequency varies. You may receive up to 8 messages per month. Frequency may
              increase during holiday periods or special promotions.
            </p>
          </div>

          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Message &amp; Data Rates</h3>
            <p class="text-stone-400">
              Message and data rates may apply. Please contact your mobile carrier for pricing
              details associated with your messaging plan.
            </p>
          </div>

          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Opt Out</h3>
            <p class="text-stone-400">
              You may opt out at any time by texting <strong class="text-brand-secondary">STOP</strong> to
              any message you receive from us. After texting STOP, you will receive a one-time
              confirmation message and will no longer receive text messages from us unless you
              opt in again.
            </p>
          </div>

          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Help</h3>
            <p class="text-stone-400">
              For help, text <strong class="text-brand-secondary">HELP</strong> to any message, or
              call us at <a href="tel:+12486343555" class="text-brand-secondary hover:underline">(248) 634-3555</a>.
            </p>
          </div>

          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Supported Carriers</h3>
            <p class="text-stone-400">
              Compatible with most major US carriers including AT&amp;T, Verizon, T-Mobile, Sprint,
              and others. Carriers are not liable for delayed or undelivered messages.
            </p>
          </div>

          <div>
            <h3 class="text-brand-cream font-semibold mb-1">Privacy</h3>
            <p class="text-stone-400">
              Your phone number and opt-in data will not be sold to or shared with third parties
              or affiliates for marketing or promotional purposes. See our
              <a href="/privacy/#sms-privacy" class="text-brand-secondary hover:underline">Privacy Policy</a>
              for full details on how we handle your information.
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Menu &amp; Pricing</h2>
        <p>
          Menu items, prices, availability, and specials are subject to change without notice.
          While we make every effort to ensure accuracy, we do not guarantee that all information
          on our website is error-free. Photos are for illustration purposes and may not exactly
          represent the items served.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Intellectual Property</h2>
        <p>
          All content on this website — including text, images, logos, and graphics — is the
          property of Mike's Coney Island and is protected by applicable intellectual property
          laws. You may not reproduce, distribute, or create derivative works from our content
          without written permission.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Limitation of Liability</h2>
        <p>
          Mike's Coney Island provides this website and its content on an "as is" basis. We make
          no warranties, express or implied, regarding the accuracy, reliability, or availability
          of the website. To the fullest extent permitted by law, we shall not be liable for any
          damages arising from your use of the website or services.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Governing Law</h2>
        <p>
          These Terms &amp; Conditions are governed by and construed in accordance with the laws
          of the State of Michigan. Any disputes arising from these terms shall be subject to
          the exclusive jurisdiction of the courts in Oakland County, Michigan.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Changes to These Terms</h2>
        <p>
          We reserve the right to update these Terms &amp; Conditions at any time. Changes will be
          effective immediately upon posting to this page. Your continued use of the website after
          changes constitutes acceptance of the revised terms.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl text-brand-cream mb-3">Contact Us</h2>
        <p>If you have questions about these Terms &amp; Conditions, contact us at:</p>
        <div class="mt-3 text-stone-400">
          <p>Mike's Coney Island</p>
          <p>15203 N Holly Rd, Holly, MI 48442</p>
          <p>Phone: <a href="tel:+12486343555" class="text-brand-secondary hover:underline">(248) 634-3555</a></p>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
