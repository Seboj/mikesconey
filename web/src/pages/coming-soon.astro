---
export const prerender = false;

import BaseHead from "../components/BaseHead.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent } from "../../../shared/types";

let siteInfo: SiteInfoContent | null = null;
let hours: HoursContent | null = null;

try {
  [siteInfo, hours] = await Promise.all([
    fetchContent<SiteInfoContent>("site_info"),
    fetchContent<HoursContent>("hours"),
  ]);
} catch {
  // Use fallback values
}

const name = siteInfo?.name || "Mike's Coney Island";
const tagline = siteInfo?.tagline || "Holly's favorite coney island since 1987";
const phone = siteInfo?.phone;
const address = siteInfo?.address;
const social = siteInfo?.social;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Coming Soon" description={`${name} — ${tagline}. Full website coming soon!`} siteInfo={siteInfo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap" rel="stylesheet" />
    <style>
      :root {
        --diner-bg: #0c0a09;
        --diner-surface: #1c1917;
        --diner-border: #292524;
        --diner-cream: #fef3c7;
        --diner-cream-dim: #d6c9a3;
        --diner-amber: #f59e0b;
        --diner-red: #ef4444;
        --diner-red-deep: #b91c1c;
        --diner-red-glow: #ef444480;
        --diner-warm-gray: #a8a29e;
        --diner-warm-light: #e7e5e4;
      }

      body.coming-soon-body {
        margin: 0;
        min-height: 100vh;
        background: var(--diner-bg);
        color: var(--diner-cream);
        font-family: 'Inter Variable', system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
        position: relative;
      }

      /* Grain overlay */
      body.coming-soon-body::before {
        content: '';
        position: fixed;
        inset: 0;
        opacity: 0.035;
        pointer-events: none;
        z-index: 100;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      /* Ambient warm glow from top */
      body.coming-soon-body::after {
        content: '';
        position: fixed;
        top: -40%;
        left: 50%;
        transform: translateX(-50%);
        width: 120%;
        height: 60%;
        background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.06) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      .cs-container {
        position: relative;
        z-index: 1;
        max-width: 480px;
        margin: 0 auto;
        padding: 3rem 1.5rem 2rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      /* Neon restaurant name */
      .cs-title {
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(2.2rem, 8vw, 3.2rem);
        color: var(--diner-red);
        text-align: center;
        line-height: 1.1;
        margin-bottom: 0.5rem;
        text-shadow:
          0 0 10px var(--diner-red-glow),
          0 0 40px rgba(239, 68, 68, 0.2),
          0 0 80px rgba(239, 68, 68, 0.1);
        animation: flicker 4s infinite;
      }

      @keyframes flicker {
        0%, 100% { opacity: 1; }
        92% { opacity: 1; }
        93% { opacity: 0.85; }
        94% { opacity: 1; }
        96% { opacity: 0.9; }
        97% { opacity: 1; }
      }

      .cs-tagline {
        font-size: 0.95rem;
        color: var(--diner-cream-dim);
        text-align: center;
        letter-spacing: 0.03em;
        margin-bottom: 2rem;
      }

      /* Divider */
      .cs-divider {
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--diner-amber), transparent);
        margin: 0 auto 2rem;
      }

      /* Badge */
      .cs-badge {
        display: inline-block;
        padding: 0.35rem 1rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--diner-amber);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 2px;
        background: rgba(245, 158, 11, 0.06);
        margin-bottom: 0.75rem;
      }

      .cs-subtitle {
        font-size: 0.85rem;
        color: var(--diner-warm-gray);
        text-align: center;
        line-height: 1.6;
        max-width: 340px;
        margin: 0 auto 2.5rem;
      }

      /* Contact section */
      .cs-contact {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
        width: 100%;
      }

      .cs-contact-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        padding: 0.7rem 1rem;
        border-radius: 6px;
        background: var(--diner-surface);
        border: 1px solid var(--diner-border);
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .cs-contact-link:hover {
        border-color: var(--diner-amber);
        background: rgba(245, 158, 11, 0.05);
      }

      .cs-contact-icon {
        width: 18px;
        height: 18px;
        color: var(--diner-amber);
        flex-shrink: 0;
      }

      .cs-phone-text {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--diner-cream);
        letter-spacing: 0.02em;
      }

      .cs-address-text {
        font-size: 0.8rem;
        color: var(--diner-warm-gray);
      }

      .cs-contact-link:hover .cs-address-text {
        color: var(--diner-cream-dim);
      }

      /* Hours */
      .cs-section-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--diner-amber);
        margin-bottom: 1rem;
        text-align: center;
      }

      .cs-hours {
        margin-bottom: 2.5rem;
        width: 100%;
      }

      .cs-hours-grid {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        max-width: 300px;
        margin: 0 auto;
      }

      .cs-hour-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.3rem 0;
      }

      .cs-hour-day {
        font-size: 0.8rem;
        color: var(--diner-warm-gray);
      }

      .cs-hour-time {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--diner-cream);
      }

      .cs-hour-closed {
        color: var(--diner-red);
        font-weight: 500;
      }

      /* Ask Mike */
      .cs-ask-mike {
        width: 100%;
        margin-bottom: 2.5rem;
        padding: 1.25rem;
        background: var(--diner-surface);
        border: 1px solid var(--diner-border);
        border-radius: 10px;
        position: relative;
      }

      .cs-ask-mike::before {
        content: '';
        position: absolute;
        top: -1px;
        left: 20%;
        right: 20%;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--diner-red-deep), transparent);
      }

      .cs-ask-desc {
        font-size: 0.78rem;
        color: var(--diner-warm-gray);
        text-align: center;
        margin-bottom: 1rem;
      }

      .cs-ask-input-wrap {
        position: relative;
        max-width: 100%;
      }

      .cs-ask-input {
        width: 100%;
        padding: 0.7rem 3rem 0.7rem 1rem;
        border-radius: 6px;
        border: 1px solid var(--diner-border);
        background: var(--diner-bg);
        color: var(--diner-cream);
        font-size: 0.85rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
      }

      .cs-ask-input::placeholder {
        color: #57534e;
      }

      .cs-ask-input:focus {
        border-color: var(--diner-red-deep);
        box-shadow: 0 0 0 2px rgba(185, 28, 28, 0.15);
      }

      .cs-ask-btn {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        width: 32px;
        height: 32px;
        border-radius: 4px;
        border: none;
        background: var(--diner-red-deep);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s;
      }

      .cs-ask-btn:hover { background: var(--diner-red); }
      .cs-ask-btn:disabled { opacity: 0.4; cursor: not-allowed; }
      .cs-ask-btn svg { width: 16px; height: 16px; }

      .cs-reply {
        margin-top: 1rem;
        padding: 0.85rem 1rem;
        background: rgba(245, 158, 11, 0.04);
        border-left: 3px solid var(--diner-amber);
        border-radius: 0 6px 6px 0;
        text-align: left;
      }

      .cs-reply-label {
        font-family: 'Permanent Marker', cursive;
        font-size: 0.85rem;
        color: var(--diner-amber);
        margin-right: 0.4rem;
      }

      .cs-reply-text {
        font-size: 0.82rem;
        color: var(--diner-cream-dim);
        line-height: 1.5;
      }

      .cs-loading {
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--diner-warm-gray);
      }

      .cs-loading svg {
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .cs-error {
        margin-top: 0.75rem;
        font-size: 0.8rem;
        color: var(--diner-red);
        text-align: center;
      }

      .hidden { display: none !important; }

      /* Social */
      .cs-social {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        margin-bottom: 2rem;
      }

      .cs-social-link {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--diner-border);
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--diner-warm-gray);
        text-decoration: none;
        transition: all 0.2s;
      }

      .cs-social-link:hover {
        color: var(--diner-amber);
        border-color: var(--diner-amber);
        background: rgba(245, 158, 11, 0.06);
      }

      .cs-social-link svg {
        width: 18px;
        height: 18px;
      }

      /* Footer */
      .cs-footer {
        padding-top: 1.5rem;
        border-top: 1px solid var(--diner-border);
        width: 100%;
        text-align: center;
      }

      .cs-footer p {
        font-size: 0.65rem;
        color: #57534e;
        letter-spacing: 0.05em;
      }

      /* Staggered fade-in */
      .cs-fade {
        opacity: 0;
        transform: translateY(12px);
        animation: fadeUp 0.6s ease forwards;
      }

      .cs-fade:nth-child(1) { animation-delay: 0.1s; }
      .cs-fade:nth-child(2) { animation-delay: 0.2s; }
      .cs-fade:nth-child(3) { animation-delay: 0.3s; }
      .cs-fade:nth-child(4) { animation-delay: 0.4s; }
      .cs-fade:nth-child(5) { animation-delay: 0.5s; }
      .cs-fade:nth-child(6) { animation-delay: 0.6s; }
      .cs-fade:nth-child(7) { animation-delay: 0.7s; }
      .cs-fade:nth-child(8) { animation-delay: 0.8s; }
      .cs-fade:nth-child(9) { animation-delay: 0.9s; }

      @keyframes fadeUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>
  <body class="coming-soon-body">
    <div class="cs-container">

      <!-- Restaurant Name -->
      <div class="cs-fade">
        <h1 class="cs-title">{name}</h1>
      </div>

      <p class="cs-tagline cs-fade">{tagline}</p>

      <div class="cs-divider cs-fade"></div>

      <!-- Coming Soon Badge -->
      <div class="cs-fade" style="text-align:center;">
        <span class="cs-badge">Coming Soon</span>
        <p class="cs-subtitle">
          Our new website is on its way.<br/>Stop by or give us a call!
        </p>
      </div>

      <!-- Contact Info -->
      <div class="cs-contact cs-fade">
        {phone && (
          <a href={phone.tel} class="cs-contact-link">
            <svg class="cs-contact-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="cs-phone-text">{phone.display}</span>
          </a>
        )}

        {address && (
          <a href={siteInfo?.maps?.directionsUrl || "#"} target="_blank" rel="noopener noreferrer" class="cs-contact-link">
            <svg class="cs-contact-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="cs-address-text">{address.full}</span>
          </a>
        )}
      </div>

      <!-- Hours -->
      {hours && hours.length > 0 && (
        <div class="cs-hours cs-fade">
          <div class="cs-section-label">Hours</div>
          <div class="cs-hours-grid">
            {hours.map((h) => (
              <div class="cs-hour-row">
                <span class="cs-hour-day">{h.day}</span>
                <span class={h.closed ? "cs-hour-time cs-hour-closed" : "cs-hour-time"}>
                  {h.closed ? "Closed" : `${h.open} \u2013 ${h.close}`}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Ask Mike -->
      <div class="cs-ask-mike cs-fade">
        <div class="cs-section-label">Ask Mike</div>
        <p class="cs-ask-desc">Got a question about the restaurant? Ask away!</p>
        <div class="cs-ask-input-wrap">
          <input
            id="ask-mike-input"
            type="text"
            placeholder="What are your most popular dishes?"
            maxlength="500"
            class="cs-ask-input"
          />
          <button
            id="ask-mike-btn"
            type="button"
            class="cs-ask-btn"
            aria-label="Send question"
          >
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
          </button>
        </div>
        <div id="ask-mike-reply" class="cs-reply hidden">
          <span class="cs-reply-label">Mike:</span>
          <span id="ask-mike-text" class="cs-reply-text"></span>
        </div>
        <div id="ask-mike-loading" class="cs-loading hidden">
          <svg viewBox="0 0 24 24" fill="none">
            <circle opacity="0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path opacity="0.75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          Mike is thinking...
        </div>
        <div id="ask-mike-error" class="cs-error hidden"></div>
      </div>

      <!-- Social Links -->
      {social && (
        <div class="cs-social cs-fade">
          {social.facebook && (
            <a href={social.facebook} target="_blank" rel="noopener noreferrer" class="cs-social-link" aria-label="Facebook">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {social.instagram && (
            <a href={social.instagram} target="_blank" rel="noopener noreferrer" class="cs-social-link" aria-label="Instagram">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          )}
        </div>
      )}

      <!-- Footer -->
      <div class="cs-footer cs-fade">
        <div style="display:flex;justify-content:center;gap:1rem;margin-bottom:0.75rem;">
          <a href="/privacy/" style="font-size:0.7rem;color:var(--diner-warm-gray);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--diner-cream-dim)'" onmouseout="this.style.color='var(--diner-warm-gray)'">Privacy Policy</a>
          <span style="color:#57534e;">|</span>
          <a href="/terms/" style="font-size:0.7rem;color:var(--diner-warm-gray);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--diner-cream-dim)'" onmouseout="this.style.color='var(--diner-warm-gray)'">Terms &amp; Conditions</a>
        </div>
        <p>&copy; {new Date().getFullYear()} {name}. All rights reserved.</p>
      </div>

    </div>

    <script>
      const input = document.getElementById("ask-mike-input") as HTMLInputElement;
      const btn = document.getElementById("ask-mike-btn") as HTMLButtonElement;
      const replyBox = document.getElementById("ask-mike-reply")!;
      const replyText = document.getElementById("ask-mike-text")!;
      const loading = document.getElementById("ask-mike-loading")!;
      const errorBox = document.getElementById("ask-mike-error")!;

      async function askMike() {
        const message = input.value.trim();
        if (!message) return;

        btn.disabled = true;
        input.disabled = true;
        replyBox.classList.add("hidden");
        errorBox.classList.add("hidden");
        loading.classList.remove("hidden");

        try {
          const res = await fetch("/api/ask-mike", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || "Something went wrong");
          }

          replyText.textContent = data.reply;
          replyBox.classList.remove("hidden");
        } catch (err: any) {
          errorBox.textContent = err.message || "Failed to get a response. Try again!";
          errorBox.classList.remove("hidden");
        } finally {
          loading.classList.add("hidden");
          btn.disabled = false;
          input.disabled = false;
          input.focus();
        }
      }

      btn.addEventListener("click", askMike);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") askMike();
      });
    </script>
  </body>
</html>
