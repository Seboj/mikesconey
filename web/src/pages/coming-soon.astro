---
export const prerender = false;

import BaseHead from "../components/BaseHead.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent } from "../../../shared/types";

let siteInfo: SiteInfoContent | null = null;
let hours: HoursContent | null = null;

try {
  [siteInfo, hours] = await Promise.all([
    fetchContent<SiteInfoContent>("site_info"),
    fetchContent<HoursContent>("hours"),
  ]);
} catch {
  // Use fallback values
}

const name = siteInfo?.name || "Mike's Coney Island";
const tagline = siteInfo?.tagline || "Holly's favorite coney island since 1987";
const phone = siteInfo?.phone;
const address = siteInfo?.address;
const social = siteInfo?.social;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Coming Soon" description={`${name} — ${tagline}. Full website coming soon!`} siteInfo={siteInfo} />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-brand-dark-deeper text-brand-text-light">
    <div class="w-full max-w-lg mx-auto px-6 py-16 text-center">
      <!-- Logo / Name -->
      <div class="mb-8">
        <div class="w-16 h-1 bg-brand-primary mx-auto mb-6 rounded-full"></div>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-3">
          {name}
        </h1>
        <p class="text-brand-text-light/70 text-lg">
          {tagline}
        </p>
      </div>

      <!-- Coming Soon -->
      <div class="mb-10">
        <span class="inline-block px-4 py-1.5 rounded-full text-sm font-medium bg-brand-primary/20 text-brand-primary-light border border-brand-primary/30 mb-4">
          Coming Soon
        </span>
        <p class="text-brand-text-light/60 text-sm leading-relaxed max-w-sm mx-auto">
          Our new website is on its way. In the meantime, stop by or give us a call!
        </p>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4 mb-10">
        {phone && (
          <a
            href={phone.tel}
            class="flex items-center justify-center gap-3 text-white hover:text-brand-primary-light transition-colors"
          >
            <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="text-lg font-medium">{phone.display}</span>
          </a>
        )}

        {address && (
          <a
            href={siteInfo?.maps?.directionsUrl || "#"}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 text-brand-text-light/70 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-sm">{address.full}</span>
          </a>
        )}
      </div>

      <!-- Hours -->
      {hours && hours.length > 0 && (
        <div class="mb-10">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-brand-primary-light mb-4">Hours</h2>
          <div class="space-y-1.5 text-sm">
            {hours.map((h) => (
              <div class="flex justify-between max-w-xs mx-auto">
                <span class="text-brand-text-light/70">{h.day}</span>
                <span class="text-white font-medium">
                  {h.closed ? "Closed" : `${h.open} – ${h.close}`}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Social links -->
      {social && (
        <div class="flex items-center justify-center gap-4">
          {social.facebook && (
            <a
              href={social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-brand-primary/30 hover:text-brand-primary-light transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {social.instagram && (
            <a
              href={social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-brand-primary/30 hover:text-brand-primary-light transition-colors"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          )}
        </div>
      )}

      <!-- Footer -->
      <div class="mt-16 pt-6 border-t border-white/10">
        <p class="text-xs text-brand-text-light/30">
          &copy; {new Date().getFullYear()} {name}. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
