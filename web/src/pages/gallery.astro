---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/gallery/GalleryGrid.astro";
import Lightbox from "../components/gallery/Lightbox.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent, GalleryContent } from "../../../shared/types";

const [siteInfo, hours, images] = await Promise.all([
  fetchContent<SiteInfoContent>("site_info"),
  fetchContent<HoursContent>("hours"),
  fetchContent<GalleryContent>("gallery"),
]);
---

<BaseLayout title="Gallery" description="Take a peek inside Mike's Coney Island — food, atmosphere, and the people who make it special." siteInfo={siteInfo} hours={hours}>
  <!-- Page header -->
  <section class="bg-brand-dark-deeper relative overflow-hidden py-14 md:py-20">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[60%] bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.05)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 md:px-8 text-center">
      <h1 class="font-display text-3xl md:text-5xl text-brand-primary text-neon-red mb-3">
        Gallery
      </h1>
      <div class="divider-amber w-16 mx-auto mb-4"></div>
      <p class="text-stone-400 text-lg">
        A peek inside Mike's Coney Island
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 px-4 md:px-8">
    <div class="mx-auto max-w-6xl">
      <GalleryGrid images={images} />

      <p class="text-center text-brand-text-muted text-sm mt-12">
        Real photos coming soon! Stay tuned.
      </p>
    </div>
  </section>
  <Lightbox />
</BaseLayout>
