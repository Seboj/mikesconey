---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryNav from "../components/menu/CategoryNav.astro";
import MenuSection from "../components/menu/MenuSection.astro";
import { fetchContent } from "../lib/api";
import type { SiteInfoContent, HoursContent, MenuContent } from "../../../shared/types";

const [siteInfo, hours, menuData] = await Promise.all([
  fetchContent<SiteInfoContent>("site_info"),
  fetchContent<HoursContent>("hours"),
  fetchContent<MenuContent>("menu"),
]);
---

<BaseLayout title="Menu" siteInfo={siteInfo} hours={hours}>
  <!-- Page header -->
  <section class="bg-brand-dark-deeper relative overflow-hidden py-14 md:py-20">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[60%] bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.05)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 md:px-8 text-center">
      <h1 class="font-display text-3xl md:text-5xl text-brand-primary text-neon-red mb-3">
        Our Menu
      </h1>
      <div class="divider-amber w-16 mx-auto mb-4"></div>
      <p class="text-stone-400 text-lg max-w-2xl mx-auto">
        Classic Michigan coney island fare — coneys, burgers, breakfast served all day, and more.
      </p>
    </div>
  </section>

  <CategoryNav categories={menuData.categories} />

  <div class="mx-auto max-w-4xl px-4 md:px-8 py-8 md:py-12">
    {menuData.categories.map((category) => (
      <MenuSection category={category} />
    ))}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('[data-menu-section]');
      const navLinks = document.querySelectorAll('[data-category-link]');

      if (sections.length === 0 || navLinks.length === 0) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              navLinks.forEach((link) => {
                const isActive = link.getAttribute('href') === `#${id}`;
                link.classList.toggle('text-brand-primary', isActive);
                link.classList.toggle('bg-brand-primary/10', isActive);
                link.classList.toggle('text-brand-text-muted', !isActive);
              });
              scrollNavToActive();
            }
          });
        },
        {
          rootMargin: '-120px 0px -70% 0px',
          threshold: 0
        }
      );

      sections.forEach((section) => observer.observe(section));

      navLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('href')?.slice(1);
          const target = targetId ? document.getElementById(targetId) : null;
          if (target) {
            target.scrollIntoView({ behavior: scrollBehavior, block: 'start' });
            history.pushState(null, '', `#${targetId}`);
          }
        });
      });

      function scrollNavToActive() {
        const activeLink = document.querySelector('[data-category-link].text-brand-primary');
        if (activeLink && activeLink instanceof HTMLElement) {
          const nav = activeLink.closest('.overflow-x-auto');
          if (nav) {
            const linkLeft = activeLink.offsetLeft;
            const linkWidth = activeLink.offsetWidth;
            const navScroll = nav.scrollLeft;
            const navWidth = nav.offsetWidth;

            if (linkLeft < navScroll || linkLeft + linkWidth > navScroll + navWidth) {
              nav.scrollTo({
                left: linkLeft - navWidth / 2 + linkWidth / 2,
                behavior: scrollBehavior
              });
            }
          }
        }
      }
    });
  </script>
</BaseLayout>
