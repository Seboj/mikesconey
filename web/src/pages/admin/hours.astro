---
export const prerender = false;

import AdminLayout from "../../components/admin/AdminLayout.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";

const cookie = Astro.request.headers.get("cookie") || "";

interface HoursEntry {
  day: string;
  open: string;
  close: string;
  closed?: boolean;
}

const defaultHours: HoursEntry[] = [
  { day: "Monday", open: "10:00 AM", close: "9:00 PM", closed: false },
  { day: "Tuesday", open: "10:00 AM", close: "9:00 PM", closed: false },
  { day: "Wednesday", open: "10:00 AM", close: "9:00 PM", closed: false },
  { day: "Thursday", open: "10:00 AM", close: "9:00 PM", closed: false },
  { day: "Friday", open: "10:00 AM", close: "10:00 PM", closed: false },
  { day: "Saturday", open: "10:00 AM", close: "10:00 PM", closed: false },
  { day: "Sunday", open: "11:00 AM", close: "8:00 PM", closed: false },
];

let hours: HoursEntry[] = defaultHours;

try {
  const res = await fetch(`${apiUrl}/api/admin/content/hours`, {
    headers: { cookie },
  });

  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data) && data.length > 0) {
      hours = data;
    }
  }
} catch {
  // Failed to load hours data
}
---

<AdminLayout title="Hours" activePage="hours">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Operating Hours</h1>
    <p class="text-sm text-brand-text-muted mt-1">Manage your restaurant's weekly operating hours.</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="font-heading font-semibold text-brand-text-heading">Weekly Schedule</h2>
    </div>

    <form id="hours-form" class="p-6">
      <!-- Header row (hidden on mobile, visible on sm+) -->
      <div class="hidden sm:grid sm:grid-cols-[160px_1fr_1fr_100px] gap-4 mb-3 px-1">
        <span class="text-xs font-medium text-brand-text-muted uppercase tracking-wider">Day</span>
        <span class="text-xs font-medium text-brand-text-muted uppercase tracking-wider">Open</span>
        <span class="text-xs font-medium text-brand-text-muted uppercase tracking-wider">Close</span>
        <span class="text-xs font-medium text-brand-text-muted uppercase tracking-wider">Closed</span>
      </div>

      <div class="space-y-3">
        {hours.map((entry, i) => (
          <div
            class="hours-row grid grid-cols-1 sm:grid-cols-[160px_1fr_1fr_100px] gap-3 sm:gap-4 items-center p-4 sm:p-3 rounded-lg border border-gray-100 bg-gray-50/50 hover:bg-gray-50 transition-colors"
            data-index={i}
          >
            <div class="flex items-center gap-3 sm:gap-0">
              <svg class="w-5 h-5 text-brand-text-muted sm:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-medium text-brand-text-heading text-sm">{entry.day}</span>
              <input type="hidden" name={`day-${i}`} value={entry.day} />
            </div>

            <div>
              <label class="block text-xs text-brand-text-muted mb-1 sm:hidden">Open</label>
              <input
                type="text"
                name={`open-${i}`}
                value={entry.open}
                placeholder="e.g. 10:00 AM"
                disabled={entry.closed}
                class:list={[
                  "hours-open w-full px-3 py-2 rounded-lg border border-gray-200 bg-white text-sm text-brand-text-body placeholder:text-brand-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition-colors",
                  entry.closed && "opacity-50 bg-gray-100 cursor-not-allowed",
                ]}
              />
            </div>

            <div>
              <label class="block text-xs text-brand-text-muted mb-1 sm:hidden">Close</label>
              <input
                type="text"
                name={`close-${i}`}
                value={entry.close}
                placeholder="e.g. 9:00 PM"
                disabled={entry.closed}
                class:list={[
                  "hours-close w-full px-3 py-2 rounded-lg border border-gray-200 bg-white text-sm text-brand-text-body placeholder:text-brand-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition-colors",
                  entry.closed && "opacity-50 bg-gray-100 cursor-not-allowed",
                ]}
              />
            </div>

            <div class="flex items-center">
              <label class="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  name={`closed-${i}`}
                  checked={entry.closed}
                  class="hours-closed rounded border-gray-300 text-brand-primary focus:ring-brand-primary/30"
                />
                <span class="text-sm text-brand-text-body">Closed</span>
              </label>
            </div>
          </div>
        ))}
      </div>

      <!-- Error / Success message -->
      <div id="hours-message" class="hidden mt-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

      <!-- Save button -->
      <div class="mt-6 flex items-center justify-end gap-3">
        <button
          type="submit"
          id="save-btn"
          class="px-6 py-2.5 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-brand-primary-dark transition-colors focus:outline-none focus:ring-2 focus:ring-brand-primary/30 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Save Changes
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("hours-form") as HTMLFormElement;
  const messageEl = document.getElementById("hours-message")!;
  const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;

  // Handle closed checkbox toggles
  document.querySelectorAll(".hours-row").forEach((row) => {
    const closedCheckbox = row.querySelector(".hours-closed") as HTMLInputElement;
    const openInput = row.querySelector(".hours-open") as HTMLInputElement;
    const closeInput = row.querySelector(".hours-close") as HTMLInputElement;

    closedCheckbox.addEventListener("change", () => {
      const isClosed = closedCheckbox.checked;
      openInput.disabled = isClosed;
      closeInput.disabled = isClosed;

      if (isClosed) {
        openInput.classList.add("opacity-50", "bg-gray-100", "cursor-not-allowed");
        closeInput.classList.add("opacity-50", "bg-gray-100", "cursor-not-allowed");
      } else {
        openInput.classList.remove("opacity-50", "bg-gray-100", "cursor-not-allowed");
        closeInput.classList.remove("opacity-50", "bg-gray-100", "cursor-not-allowed");
      }
    });
  });

  function showMessage(text: string, isError: boolean) {
    messageEl.textContent = text;
    messageEl.classList.remove("hidden", "bg-green-50", "text-green-700", "bg-red-50", "text-red-700");
    if (isError) {
      messageEl.classList.add("bg-red-50", "text-red-700");
    } else {
      messageEl.classList.add("bg-green-50", "text-green-700");
    }

    // Auto-hide success messages after 4 seconds
    if (!isError) {
      setTimeout(() => {
        messageEl.classList.add("hidden");
      }, 4000);
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const rows = document.querySelectorAll(".hours-row");
    const hours: Array<{ day: string; open: string; close: string; closed: boolean }> = [];

    rows.forEach((row, i) => {
      const day = (row.querySelector(`input[name="day-${i}"]`) as HTMLInputElement).value;
      const open = (row.querySelector(`input[name="open-${i}"]`) as HTMLInputElement).value.trim();
      const close = (row.querySelector(`input[name="close-${i}"]`) as HTMLInputElement).value.trim();
      const closed = (row.querySelector(`input[name="closed-${i}"]`) as HTMLInputElement).checked;

      hours.push({ day, open, close, closed });
    });

    // Basic validation: ensure open/close are filled for non-closed days
    for (const entry of hours) {
      if (!entry.closed && (!entry.open || !entry.close)) {
        showMessage(`Please enter both open and close times for ${entry.day}, or mark it as Closed.`, true);
        return;
      }
    }

    saveBtn.disabled = true;
    saveBtn.textContent = "Saving...";

    try {
      const res = await fetch("/api/admin/content/hours", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(hours),
      });

      if (res.ok) {
        showMessage("Hours updated successfully.", false);
      } else {
        const data = await res.json().catch(() => ({}));
        showMessage(data.error || "Failed to save hours. Please try again.", true);
      }
    } catch {
      showMessage("Network error. Please check your connection and try again.", true);
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Save Changes";
    }
  });
</script>
