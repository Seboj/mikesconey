---
export const prerender = false;

import AdminLayout from "../../components/admin/AdminLayout.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";

const cookie = Astro.request.headers.get("cookie") || "";
const url = new URL(Astro.request.url);
const search = url.searchParams.get("search") || "";
const page = parseInt(url.searchParams.get("page") || "1", 10);
const sort = url.searchParams.get("sort") || "created_at";
const order = url.searchParams.get("order") || "desc";

let customers: any[] = [];
let total = 0;
let totalPages = 1;

try {
  const params = new URLSearchParams({ page: String(page), limit: "25", sort, order });
  if (search) params.set("search", search);

  const res = await fetch(`${apiUrl}/api/admin/customers?${params}`, {
    headers: { cookie },
  });

  if (res.ok) {
    const data = await res.json();
    customers = data.data || [];
    total = data.total || 0;
    totalPages = data.totalPages || 1;
  }
} catch {
  // Failed to load
}
---

<AdminLayout title="Customers" activePage="customers">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Customers</h1>
      <p class="text-sm text-brand-text-muted mt-1">{total} total customer{total !== 1 ? "s" : ""}</p>
    </div>
  </div>

  <!-- Search -->
  <div class="mb-6">
    <form method="get" class="flex gap-3">
      <div class="flex-1 max-w-md">
        <label for="search" class="sr-only">Search customers</label>
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="search"
            name="search"
            value={search}
            placeholder="Search by name, email, or phone..."
            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-200 bg-white text-sm text-brand-text-body placeholder:text-brand-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition-colors"
          />
        </div>
      </div>
      <button
        type="submit"
        class="px-4 py-2.5 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-brand-primary-dark transition-colors"
      >
        Search
      </button>
      {search && (
        <a
          href="/admin/customers"
          class="px-4 py-2.5 bg-gray-100 text-brand-text-body text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors"
        >
          Clear
        </a>
      )}
    </form>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    {customers.length > 0 ? (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50/50">
              <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Name</th>
              <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Email</th>
              <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Phone</th>
              <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Opt-In</th>
              <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Source</th>
              <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Signed Up</th>
              <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {customers.map((c: any) => (
              <tr class="hover:bg-gray-50/50 transition-colors group" data-customer-id={c.id}>
                <td class="px-6 py-3 font-medium text-brand-text-heading">
                  {c.firstName} {c.lastName}
                </td>
                <td class="px-6 py-3 text-brand-text-body">{c.email}</td>
                <td class="px-6 py-3 text-brand-text-body">{c.phone || "—"}</td>
                <td class="px-6 py-3">
                  <span class="inline-flex gap-1">
                    {c.optInEmail && <span class="px-2 py-0.5 text-xs font-medium bg-green-50 text-green-700 rounded-full">Email</span>}
                    {c.optInSms && <span class="px-2 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 rounded-full">SMS</span>}
                  </span>
                </td>
                <td class="px-6 py-3 text-brand-text-muted capitalize">{c.source}</td>
                <td class="px-6 py-3 text-brand-text-muted">
                  {new Date(c.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                </td>
                <td class="px-6 py-3 text-right">
                  <div class="inline-flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button
                      class="edit-btn p-1.5 rounded-lg text-brand-text-muted hover:text-brand-primary hover:bg-brand-primary/5 transition-colors"
                      data-id={c.id}
                      data-firstname={c.firstName}
                      data-lastname={c.lastName}
                      data-email={c.email}
                      data-phone={c.phone || ""}
                      data-optinemail={c.optInEmail}
                      data-optinsms={c.optInSms}
                      data-notes={c.notes || ""}
                      title="Edit"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                    <button
                      class="delete-btn p-1.5 rounded-lg text-brand-text-muted hover:text-red-600 hover:bg-red-50 transition-colors"
                      data-id={c.id}
                      data-name={`${c.firstName} ${c.lastName}`}
                      title="Delete"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="px-6 py-12 text-center">
        <p class="text-brand-text-muted">
          {search ? `No customers found matching "${search}".` : "No customers yet."}
        </p>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
        <p class="text-sm text-brand-text-muted">
          Page {page} of {totalPages}
        </p>
        <div class="flex gap-2">
          {page > 1 && (
            <a
              href={`/admin/customers?page=${page - 1}${search ? `&search=${encodeURIComponent(search)}` : ""}&sort=${sort}&order=${order}`}
              class="px-3 py-1.5 text-sm bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
            >
              Previous
            </a>
          )}
          {page < totalPages && (
            <a
              href={`/admin/customers?page=${page + 1}${search ? `&search=${encodeURIComponent(search)}` : ""}&sort=${sort}&order=${order}`}
              class="px-3 py-1.5 text-sm bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
            >
              Next
            </a>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6">
      <h3 class="font-heading text-lg font-bold text-brand-text-heading mb-4">Edit Customer</h3>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-id" />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="edit-firstname" class="block text-sm font-medium text-brand-text-body mb-1">First Name</label>
            <input type="text" id="edit-firstname" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/30" />
          </div>
          <div>
            <label for="edit-lastname" class="block text-sm font-medium text-brand-text-body mb-1">Last Name</label>
            <input type="text" id="edit-lastname" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/30" />
          </div>
        </div>
        <div>
          <label for="edit-email" class="block text-sm font-medium text-brand-text-body mb-1">Email</label>
          <input type="email" id="edit-email" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/30" />
        </div>
        <div>
          <label for="edit-phone" class="block text-sm font-medium text-brand-text-body mb-1">Phone</label>
          <input type="tel" id="edit-phone" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/30" />
        </div>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="edit-optinemail" class="rounded border-gray-300 text-brand-primary focus:ring-brand-primary/30" />
            Email opt-in
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="edit-optinsms" class="rounded border-gray-300 text-brand-primary focus:ring-brand-primary/30" />
            SMS opt-in
          </label>
        </div>
        <div>
          <label for="edit-notes" class="block text-sm font-medium text-brand-text-body mb-1">Notes</label>
          <textarea id="edit-notes" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/30 resize-none"></textarea>
        </div>
        <p id="edit-error" class="hidden text-sm text-brand-primary"></p>
        <div class="flex gap-3 justify-end">
          <button type="button" id="edit-cancel" class="px-4 py-2 text-sm text-brand-text-body bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
          <button type="submit" class="px-4 py-2 text-sm text-white bg-brand-primary rounded-lg hover:bg-brand-primary-dark transition-colors">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 p-6 text-center">
      <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h3 class="font-heading text-lg font-bold text-brand-text-heading mb-2">Delete Customer</h3>
      <p class="text-sm text-brand-text-muted mb-6">
        Are you sure you want to delete <strong id="delete-name"></strong>? This action cannot be undone.
      </p>
      <input type="hidden" id="delete-id" />
      <div class="flex gap-3 justify-center">
        <button id="delete-cancel" class="px-4 py-2 text-sm text-brand-text-body bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
        <button id="delete-confirm" class="px-4 py-2 text-sm text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors">Delete</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Edit modal
  const editModal = document.getElementById("edit-modal")!;
  const editForm = document.getElementById("edit-form") as HTMLFormElement;
  const editError = document.getElementById("edit-error")!;

  document.querySelectorAll(".edit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = btn as HTMLElement;
      (document.getElementById("edit-id") as HTMLInputElement).value = el.dataset.id!;
      (document.getElementById("edit-firstname") as HTMLInputElement).value = el.dataset.firstname!;
      (document.getElementById("edit-lastname") as HTMLInputElement).value = el.dataset.lastname!;
      (document.getElementById("edit-email") as HTMLInputElement).value = el.dataset.email!;
      (document.getElementById("edit-phone") as HTMLInputElement).value = el.dataset.phone!;
      (document.getElementById("edit-optinemail") as HTMLInputElement).checked = el.dataset.optinemail === "true";
      (document.getElementById("edit-optinsms") as HTMLInputElement).checked = el.dataset.optinsms === "true";
      (document.getElementById("edit-notes") as HTMLTextAreaElement).value = el.dataset.notes!;
      editError.classList.add("hidden");
      editModal.classList.remove("hidden");
    });
  });

  document.getElementById("edit-cancel")?.addEventListener("click", () => {
    editModal.classList.add("hidden");
  });

  editForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = (document.getElementById("edit-id") as HTMLInputElement).value;
    const body = {
      firstName: (document.getElementById("edit-firstname") as HTMLInputElement).value,
      lastName: (document.getElementById("edit-lastname") as HTMLInputElement).value,
      email: (document.getElementById("edit-email") as HTMLInputElement).value,
      phone: (document.getElementById("edit-phone") as HTMLInputElement).value || null,
      optInEmail: (document.getElementById("edit-optinemail") as HTMLInputElement).checked,
      optInSms: (document.getElementById("edit-optinsms") as HTMLInputElement).checked,
      notes: (document.getElementById("edit-notes") as HTMLTextAreaElement).value || null,
    };

    try {
      const res = await fetch(`/api/admin/customers/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        editError.textContent = data.error || "Failed to update";
        editError.classList.remove("hidden");
      }
    } catch {
      editError.textContent = "Network error";
      editError.classList.remove("hidden");
    }
  });

  // Delete modal
  const deleteModal = document.getElementById("delete-modal")!;

  document.querySelectorAll(".delete-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = btn as HTMLElement;
      (document.getElementById("delete-id") as HTMLInputElement).value = el.dataset.id!;
      document.getElementById("delete-name")!.textContent = el.dataset.name!;
      deleteModal.classList.remove("hidden");
    });
  });

  document.getElementById("delete-cancel")?.addEventListener("click", () => {
    deleteModal.classList.add("hidden");
  });

  document.getElementById("delete-confirm")?.addEventListener("click", async () => {
    const id = (document.getElementById("delete-id") as HTMLInputElement).value;
    try {
      const res = await fetch(`/api/admin/customers/${id}`, { method: "DELETE" });
      if (res.ok) {
        window.location.reload();
      }
    } catch {
      // silently fail
    }
  });

  // Close modals on backdrop click
  [editModal, deleteModal].forEach((modal) => {
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.add("hidden");
    });
  });
</script>
