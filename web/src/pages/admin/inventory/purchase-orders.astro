---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let pos: any[] = [];
try {
  const res = await fetch(`${apiUrl}/api/admin/inventory/po`, { headers: { cookie } });
  if (res.ok) pos = await res.json();
} catch {}

function statusBadge(po: any) {
  const s = po.status;
  if (s === "confirmed") return { class: "bg-green-50 text-green-700", label: "Confirmed" };
  if (s === "voided") return { class: "bg-red-50 text-red-700", label: "Voided" };
  return { class: "bg-amber-50 text-amber-700", label: "Draft" };
}

function paymentBadge(status: string | null) {
  if (!status || status === "unpaid") return { class: "bg-stone-100 text-stone-600", label: "Unpaid" };
  if (status === "paid") return { class: "bg-green-50 text-green-700", label: "Paid" };
  if (status === "cod") return { class: "bg-blue-50 text-blue-700", label: "COD" };
  if (status === "partial") return { class: "bg-amber-50 text-amber-700", label: "Partial" };
  if (status === "voided") return { class: "bg-red-50 text-red-700", label: "Voided" };
  if (status === "disputed") return { class: "bg-red-50 text-red-700", label: "Disputed" };
  return { class: "bg-stone-100 text-stone-600", label: status };
}
---

<AdminLayout title="Purchase Orders" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Review and confirm purchase orders.</p>
  </div>

  <InventoryNav active="purchase-orders" />

  <div class="flex gap-3 mb-4">
    <a href="/admin/inventory/scan" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">
      + Scan New Invoice
    </a>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Date</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Vendor</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Invoice #</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Total</th>
            <th class="text-center px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Status</th>
            <th class="text-center px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Payment</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {pos.map((po) => {
            const sb = statusBadge(po);
            const pb = paymentBadge(po.paymentStatus);
            return (
              <tr class="hover:bg-stone-50 cursor-pointer" onclick={`if(!event.target.closest('button'))window.location='/admin/inventory/po/${po.id}'`}>
                <td class="px-6 py-3 text-brand-text-body">{new Date(po.orderDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</td>
                <td class="px-6 py-3 font-medium text-brand-text-heading">{po.vendor?.name || "Unknown"}</td>
                <td class="px-6 py-3 text-brand-text-body font-mono text-xs">{po.invoiceNumber || "—"}</td>
                <td class="px-6 py-3 text-right font-mono text-brand-text-body">${parseFloat(po.totalCost || "0").toFixed(2)}</td>
                <td class="px-6 py-3 text-center">
                  <span class={`px-2 py-0.5 text-xs font-medium rounded-full ${sb.class}`}>{sb.label}</span>
                </td>
                <td class="px-6 py-3 text-center">
                  <span class={`px-2 py-0.5 text-xs font-medium rounded-full ${pb.class}`}>{pb.label}</span>
                </td>
                <td class="px-6 py-3 text-right space-x-2">
                  {po.status === "draft" && (
                    <button class="confirm-po text-green-600 hover:text-green-800 text-xs font-medium" data-id={po.id}>Confirm</button>
                  )}
                  {po.status === "confirmed" && (
                    <button class="void-po text-amber-600 hover:text-amber-800 text-xs font-medium" data-id={po.id}>Void</button>
                  )}
                  {po.status !== "voided" && (
                    <button class="delete-po text-red-600 hover:text-red-800 text-xs font-medium" data-id={po.id}>Delete</button>
                  )}
                </td>
              </tr>
            );
          })}
          {pos.length === 0 && (
            <tr><td colspan="7" class="px-6 py-8 text-center text-brand-text-muted">No purchase orders yet. <a href="/admin/inventory/scan" class="text-brand-primary hover:underline">Scan an invoice</a> to get started.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll(".confirm-po").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Confirm this PO? Inventory quantities will be updated.")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/po/${id}/confirm`, { method: "POST" });
      if (res.ok) window.location.reload();
      else alert("Failed to confirm PO");
    });
  });

  document.querySelectorAll(".void-po").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Void this PO? Inventory quantities will be reversed.")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/po/${id}/void`, { method: "POST" });
      if (res.ok) window.location.reload();
      else alert("Failed to void PO");
    });
  });

  document.querySelectorAll(".delete-po").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Delete this purchase order?")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/po/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
    });
  });
</script>
