---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let menuItems: any[] = [];
try {
  const res = await fetch(`${apiUrl}/api/admin/inventory/menu-items`, { headers: { cookie } });
  if (res.ok) menuItems = await res.json();
} catch {}
---

<AdminLayout title="Menu Items" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Manage menu items for inventory tracking.</p>
  </div>

  <InventoryNav active="menu-items" />

  <!-- Sync + Add -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 mb-6">
    <div class="flex flex-wrap gap-4 items-end">
      <div class="flex-1">
        <h2 class="font-heading font-semibold text-brand-text-heading mb-2">Add Menu Item</h2>
        <form id="add-mi-form" class="flex gap-3 items-end">
          <div class="flex-1 min-w-[180px]">
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Name *</label>
            <input type="text" name="name" required class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" />
          </div>
          <div class="flex-1 min-w-[180px]">
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Description</label>
            <input type="text" name="description" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" />
          </div>
          <button type="submit" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">Add</button>
        </form>
      </div>
      <div class="border-l border-stone-200 pl-4">
        <p class="text-xs text-brand-text-muted mb-2">Import from your website menu</p>
        <button id="sync-btn" class="px-4 py-2 bg-stone-700 text-white rounded-lg text-sm font-medium hover:bg-stone-800 transition-colors">
          Sync from Site Menu
        </button>
        <p id="sync-msg" class="text-xs mt-1 hidden"></p>
      </div>
    </div>
    <p id="mi-msg" class="text-sm mt-2 hidden"></p>
  </div>

  <!-- Menu Items Table -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Name</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Description</th>
            <th class="text-center px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Recipe</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {menuItems.map((mi) => (
            <tr class="hover:bg-stone-50">
              <td class="px-6 py-3 font-medium text-brand-text-heading">{mi.name}</td>
              <td class="px-6 py-3 text-brand-text-body">{mi.description || "—"}</td>
              <td class="px-6 py-3 text-center">
                <a href={`/admin/inventory/recipes?menuItemId=${mi.id}`} class="text-brand-primary hover:underline text-xs font-medium">Edit Recipe</a>
              </td>
              <td class="px-6 py-3 text-right">
                <button class="delete-mi text-red-600 hover:text-red-800 text-xs font-medium" data-id={mi.id}>Delete</button>
              </td>
            </tr>
          ))}
          {menuItems.length === 0 && (
            <tr><td colspan="4" class="px-6 py-8 text-center text-brand-text-muted">No menu items yet. Add manually or sync from your site menu.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.getElementById("add-mi-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));

    const res = await fetch("/api/admin/inventory/menu-items", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });

    if (res.ok) window.location.reload();
    else {
      const err = await res.json();
      const msg = document.getElementById("mi-msg")!;
      msg.textContent = err.error || "Failed to add item";
      msg.className = "text-sm mt-2 text-red-600";
    }
  });

  document.getElementById("sync-btn")?.addEventListener("click", async () => {
    const msg = document.getElementById("sync-msg")!;
    msg.textContent = "Syncing...";
    msg.className = "text-xs mt-1 text-brand-text-muted";

    const res = await fetch("/api/admin/inventory/menu-items/sync", { method: "POST" });
    if (res.ok) {
      const data = await res.json();
      if (data.synced > 0) {
        msg.textContent = `Imported ${data.synced} new item(s)!`;
        msg.className = "text-xs mt-1 text-green-600";
        setTimeout(() => window.location.reload(), 800);
      } else {
        msg.textContent = "All items already synced.";
        msg.className = "text-xs mt-1 text-brand-text-muted";
      }
    } else {
      msg.textContent = "Sync failed";
      msg.className = "text-xs mt-1 text-red-600";
    }
  });

  document.querySelectorAll(".delete-mi").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Delete this menu item? Its recipes will also be removed.")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/menu-items/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
    });
  });
</script>
