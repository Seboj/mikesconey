---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let vendors: any[] = [];
let items: any[] = [];
try {
  const [vRes, iRes] = await Promise.all([
    fetch(`${apiUrl}/api/admin/inventory/vendors`, { headers: { cookie } }),
    fetch(`${apiUrl}/api/admin/inventory/items`, { headers: { cookie } }),
  ]);
  if (vRes.ok) vendors = await vRes.json();
  if (iRes.ok) items = await iRes.json();
} catch {}
---

<AdminLayout title="Scan Invoice" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Upload a vendor invoice for AI-powered extraction and matching.</p>
  </div>

  <InventoryNav active="scan" />

  <!-- Stage Progress Bar -->
  <div class="mb-6">
    <div class="flex items-center gap-1">
      <div id="stage-1-indicator" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-brand-primary text-white">
        <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-[10px] font-bold">1</span>
        Upload
      </div>
      <svg class="w-4 h-4 text-stone-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
      <div id="stage-2-indicator" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-stone-100 text-stone-400">
        <span class="w-5 h-5 rounded-full bg-stone-200 flex items-center justify-center text-[10px] font-bold">2</span>
        Vendor
      </div>
      <svg class="w-4 h-4 text-stone-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
      <div id="stage-3-indicator" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-stone-100 text-stone-400">
        <span class="w-5 h-5 rounded-full bg-stone-200 flex items-center justify-center text-[10px] font-bold">3</span>
        Items
      </div>
      <svg class="w-4 h-4 text-stone-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
      <div id="stage-4-indicator" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-stone-100 text-stone-400">
        <span class="w-5 h-5 rounded-full bg-stone-200 flex items-center justify-center text-[10px] font-bold">4</span>
        Review
      </div>
    </div>
  </div>

  <!-- ══════════════ STAGE 1: Upload ══════════════ -->
  <div id="stage-1" class="space-y-4">
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="font-heading font-semibold text-brand-text-heading mb-4">Upload Invoice</h2>
      <form id="scan-form" enctype="multipart/form-data">
        <input type="file" name="invoice" accept="image/*" class="hidden" id="file-input" />
        <div class="border-2 border-dashed border-stone-300 rounded-lg p-10 text-center hover:border-brand-primary transition-colors cursor-pointer" id="drop-zone">
          <svg class="w-12 h-12 mx-auto text-stone-400 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
          <p class="text-sm text-brand-text-body mb-1 font-medium">Drag & drop or click to upload</p>
          <p class="text-xs text-brand-text-muted">JPG, PNG, WebP — max 10MB</p>
        </div>
        <div id="file-preview" class="mt-3 hidden flex items-center gap-2">
          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10" stroke="currentColor" /></svg>
          <p class="text-sm text-brand-text-body" id="file-name"></p>
        </div>
        <button type="submit" id="scan-btn" class="mt-4 w-full px-4 py-2.5 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors disabled:opacity-50" disabled>
          Extract with AI
        </button>
      </form>
      <div id="scan-status" class="mt-3 hidden">
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 border-2 border-brand-primary border-t-transparent rounded-full animate-spin"></div>
          <span class="text-sm text-brand-text-muted">Extracting invoice data (VLM)...</span>
        </div>
      </div>
      <p id="scan-error" class="text-sm mt-3 text-red-600 hidden"></p>
    </div>
  </div>

  <!-- ══════════════ STAGE 2: Vendor Resolution ══════════════ -->
  <div id="stage-2" class="hidden space-y-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Extracted Vendor Info -->
      <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
        <h2 class="font-heading font-semibold text-brand-text-heading mb-4">Extracted Vendor</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Name (as printed)</label>
            <p id="extracted-vendor-name" class="text-sm font-medium text-brand-text-heading bg-stone-50 rounded px-3 py-2"></p>
          </div>
          <div>
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Address</label>
            <p id="extracted-vendor-address" class="text-sm text-brand-text-body bg-stone-50 rounded px-3 py-2"></p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-brand-text-muted mb-1">Phone</label>
              <p id="extracted-vendor-phone" class="text-sm text-brand-text-body bg-stone-50 rounded px-3 py-2"></p>
            </div>
            <div>
              <label class="block text-xs font-medium text-brand-text-muted mb-1">Email</label>
              <p id="extracted-vendor-email" class="text-sm text-brand-text-body bg-stone-50 rounded px-3 py-2"></p>
            </div>
          </div>
          <!-- Invoice metadata -->
          <div class="pt-3 border-t border-stone-100">
            <h3 class="text-xs font-medium text-brand-text-muted uppercase mb-2">Invoice Details</h3>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-brand-text-muted mb-1">Invoice #</label>
                <input type="text" id="invoice-number" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
              </div>
              <div>
                <label class="block text-xs text-brand-text-muted mb-1">Date</label>
                <input type="date" id="invoice-date" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
              </div>
              <div>
                <label class="block text-xs text-brand-text-muted mb-1">Due Date</label>
                <input type="date" id="invoice-due-date" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
              </div>
              <div>
                <label class="block text-xs text-brand-text-muted mb-1">PO Reference</label>
                <input type="text" id="invoice-po-ref" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Vendor Match -->
      <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-heading font-semibold text-brand-text-heading">Match Vendor</h2>
          <div id="vendor-match-spinner" class="hidden flex items-center gap-2">
            <div class="w-4 h-4 border-2 border-brand-primary border-t-transparent rounded-full animate-spin"></div>
            <span class="text-xs text-brand-text-muted">Matching...</span>
          </div>
        </div>

        <div id="vendor-candidates" class="space-y-2 mb-4"></div>

        <div id="vendor-selection" class="hidden border-t border-stone-100 pt-4">
          <label class="block text-xs font-medium text-brand-text-muted mb-1">Selected Vendor</label>
          <select id="selected-vendor" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm">
            <option value="">— Select or create new —</option>
            {vendors.map((v) => <option value={v.id}>{v.name}</option>)}
          </select>
        </div>

        <div id="create-vendor-section" class="hidden border-t border-stone-100 pt-4 mt-4">
          <h3 class="text-xs font-medium text-brand-text-muted uppercase mb-2">Create New Vendor</h3>
          <div class="space-y-2">
            <input type="text" id="new-vendor-name" placeholder="Vendor name" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
            <input type="text" id="new-vendor-contact" placeholder="Contact person" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
            <input type="text" id="new-vendor-category" placeholder="Category" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" />
            <button id="create-vendor-btn" class="w-full px-3 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark">Create Vendor</button>
          </div>
        </div>

        <div id="duplicate-warning" class="hidden mt-4 bg-amber-50 border border-amber-200 rounded-lg p-3">
          <p class="text-sm text-amber-800 font-medium">Duplicate Invoice Warning</p>
          <p class="text-xs text-amber-700 mt-1" id="duplicate-details"></p>
        </div>

        <button id="vendor-next-btn" class="mt-4 w-full px-4 py-2.5 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors disabled:opacity-50" disabled>
          Continue to Item Normalization
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════ STAGE 3: Item Normalization ══════════════ -->
  <div id="stage-3" class="hidden space-y-4">
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="font-heading font-semibold text-brand-text-heading">Item Normalization</h2>
          <p class="text-xs text-brand-text-muted mt-1">AI normalizes descriptions, parses pack formats, and matches to inventory.</p>
        </div>
        <div id="normalize-spinner" class="hidden flex items-center gap-2">
          <div class="w-4 h-4 border-2 border-brand-primary border-t-transparent rounded-full animate-spin"></div>
          <span class="text-xs text-brand-text-muted">Normalizing...</span>
        </div>
      </div>

      <div class="overflow-x-auto border border-stone-200 rounded-lg">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Raw Description</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Canonical Name</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Category</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Qty</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Pack → Base</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Total Base</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">$/Base</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Line $</th>
              <th class="text-center px-3 py-2 text-xs font-medium text-brand-text-muted">Match</th>
            </tr>
          </thead>
          <tbody id="normalized-items-body"></tbody>
        </table>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <button id="items-back-btn" class="px-4 py-2 border border-stone-300 rounded-lg text-sm text-brand-text-body hover:bg-stone-50">
          Back to Vendor
        </button>
        <button id="items-next-btn" class="px-4 py-2.5 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">
          Continue to Review
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════ STAGE 4: Review & Confirm ══════════════ -->
  <div id="stage-4" class="hidden space-y-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Summary -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-stone-200 p-6">
        <h2 class="font-heading font-semibold text-brand-text-heading mb-4">Review Purchase Order</h2>

        <div class="grid grid-cols-2 gap-4 mb-6 pb-4 border-b border-stone-100">
          <div>
            <span class="text-xs text-brand-text-muted">Vendor</span>
            <p id="review-vendor" class="text-sm font-medium text-brand-text-heading"></p>
          </div>
          <div>
            <span class="text-xs text-brand-text-muted">Invoice #</span>
            <p id="review-invoice-num" class="text-sm font-medium text-brand-text-heading"></p>
          </div>
          <div>
            <span class="text-xs text-brand-text-muted">Date</span>
            <p id="review-date" class="text-sm text-brand-text-body"></p>
          </div>
          <div>
            <span class="text-xs text-brand-text-muted">Due Date</span>
            <p id="review-due-date" class="text-sm text-brand-text-body"></p>
          </div>
        </div>

        <div class="overflow-x-auto border border-stone-200 rounded-lg mb-4">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-stone-50 border-b border-stone-200">
                <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Item</th>
                <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Category</th>
                <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Qty</th>
                <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Base Units</th>
                <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Unit $</th>
                <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Line $</th>
                <th class="text-center px-3 py-2 text-xs font-medium text-brand-text-muted">Status</th>
              </tr>
            </thead>
            <tbody id="review-items-body"></tbody>
          </table>
        </div>
      </div>

      <!-- Totals & Actions -->
      <div class="space-y-4">
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
          <h3 class="font-heading font-semibold text-brand-text-heading mb-3">Totals</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-brand-text-muted">Subtotal</span>
              <span id="review-subtotal" class="font-mono text-brand-text-body">$0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-brand-text-muted">Freight</span>
              <input type="number" id="review-freight" step="0.01" value="0" class="w-24 text-right border border-stone-300 rounded px-2 py-1 text-sm font-mono" />
            </div>
            <div class="flex justify-between">
              <span class="text-brand-text-muted">Tax</span>
              <input type="number" id="review-tax" step="0.01" value="0" class="w-24 text-right border border-stone-300 rounded px-2 py-1 text-sm font-mono" />
            </div>
            <div class="flex justify-between pt-2 border-t border-stone-100 font-semibold">
              <span class="text-brand-text-heading">Total</span>
              <span id="review-total" class="font-mono text-brand-text-heading">$0.00</span>
            </div>
            <div id="total-mismatch" class="hidden bg-amber-50 border border-amber-200 rounded p-2 mt-2">
              <p class="text-xs text-amber-800">Invoice total does not match calculated total.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
          <h3 class="font-heading font-semibold text-brand-text-heading mb-3">Payment & Notes</h3>
          <div class="space-y-3">
            <div>
              <label class="block text-xs text-brand-text-muted mb-1">Payment Status</label>
              <select id="review-payment-status" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm">
                <option value="unpaid">Unpaid</option>
                <option value="cod">COD</option>
                <option value="paid">Paid</option>
                <option value="partial">Partial</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-brand-text-muted mb-1">Receiving Notes</label>
              <textarea id="review-notes" rows="3" class="w-full border border-stone-300 rounded px-2 py-1.5 text-sm" placeholder="Missing items, damage, etc."></textarea>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <button id="confirm-po-btn" class="w-full px-4 py-2.5 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition-colors">
            Confirm Purchase Order
          </button>
          <button id="review-back-btn" class="w-full px-4 py-2 border border-stone-300 rounded-lg text-sm text-brand-text-body hover:bg-stone-50">
            Back to Items
          </button>
        </div>
        <p id="confirm-msg" class="text-sm hidden"></p>
      </div>
    </div>
  </div>

  <script type="application/json" id="inv-items-data" set:html={JSON.stringify(items)}></script>
  <script type="application/json" id="inv-vendors-data" set:html={JSON.stringify(vendors)}></script>
</AdminLayout>

<script>
  const existingItems = JSON.parse(document.getElementById("inv-items-data")?.textContent || "[]");
  const existingVendors = JSON.parse(document.getElementById("inv-vendors-data")?.textContent || "[]");

  // Prevent browser from opening files dropped anywhere on the page
  document.addEventListener("dragover", (e) => e.preventDefault());
  document.addEventListener("drop", (e) => e.preventDefault());

  // ── State ──
  let extractionResult: any = null;
  let selectedVendorId: string = "";
  let selectedVendorName: string = "";
  let normalizedItems: any[] = [];
  let rawDocUrl: string | null = null;
  let rawDocS3Key: string | null = null;

  // ── Stage Navigation ──
  function setStage(n: number) {
    for (let i = 1; i <= 4; i++) {
      const stage = document.getElementById(`stage-${i}`);
      const indicator = document.getElementById(`stage-${i}-indicator`);
      if (stage) stage.classList.toggle("hidden", i !== n);
      if (indicator) {
        if (i < n) {
          indicator.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-green-100 text-green-700";
        } else if (i === n) {
          indicator.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-brand-primary text-white";
        } else {
          indicator.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-stone-100 text-stone-400";
        }
      }
    }
  }

  // ── Stage 1: Upload & Extract ──
  const dropZone = document.getElementById("drop-zone")!;
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const scanBtn = document.getElementById("scan-btn") as HTMLButtonElement;
  const scanForm = document.getElementById("scan-form")!;
  let selectedFile: File | null = null;

  dropZone.addEventListener("click", () => fileInput.click());
  dropZone.addEventListener("dragover", (e) => { e.preventDefault(); e.stopPropagation(); dropZone.classList.add("border-brand-primary"); });
  dropZone.addEventListener("dragleave", () => dropZone.classList.remove("border-brand-primary"));
  dropZone.addEventListener("drop", (e) => {
    e.preventDefault(); e.stopPropagation();
    dropZone.classList.remove("border-brand-primary");
    if (e.dataTransfer?.files[0]) setFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener("change", () => { if (fileInput.files?.[0]) setFile(fileInput.files[0]); });

  function setFile(f: File) {
    selectedFile = f;
    document.getElementById("file-name")!.textContent = f.name;
    document.getElementById("file-preview")!.classList.remove("hidden");
    scanBtn.disabled = false;
  }

  scanForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!selectedFile) return;

    const status = document.getElementById("scan-status")!;
    const errEl = document.getElementById("scan-error")!;
    status.classList.remove("hidden");
    errEl.classList.add("hidden");
    scanBtn.disabled = true;

    const fd = new FormData();
    fd.append("invoice", selectedFile);

    try {
      const res = await fetch("/api/admin/inventory/po/scan", { method: "POST", body: fd });
      if (!res.ok) throw new Error((await res.json()).error || "Scan failed");
      extractionResult = await res.json();
      rawDocUrl = extractionResult.rawDocUrl || null;
      rawDocS3Key = extractionResult.rawDocS3Key || null;
      enterStage2();
    } catch (err: any) {
      errEl.textContent = err.message;
      errEl.classList.remove("hidden");
    } finally {
      status.classList.add("hidden");
      scanBtn.disabled = false;
    }
  });

  // ── Stage 2: Vendor Resolution ──
  async function enterStage2() {
    setStage(2);
    const v = extractionResult.vendor;

    document.getElementById("extracted-vendor-name")!.textContent = v?.name || "Not detected";
    document.getElementById("extracted-vendor-address")!.textContent = v?.address || "—";
    document.getElementById("extracted-vendor-phone")!.textContent = v?.phone || "—";
    document.getElementById("extracted-vendor-email")!.textContent = v?.email || "—";

    const inv = extractionResult.invoice || {};
    (document.getElementById("invoice-number") as HTMLInputElement).value = inv.invoiceNumber || "";
    (document.getElementById("invoice-date") as HTMLInputElement).value = inv.date || new Date().toISOString().split("T")[0];
    (document.getElementById("invoice-due-date") as HTMLInputElement).value = inv.dueDate || "";
    (document.getElementById("invoice-po-ref") as HTMLInputElement).value = inv.poReference || "";

    // Match vendor via LLM
    if (v?.name) {
      const spinner = document.getElementById("vendor-match-spinner")!;
      spinner.classList.remove("hidden");
      try {
        const res = await fetch("/api/admin/inventory/po/match-vendor", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ vendorName: v.name }),
        });
        const data = await res.json();
        renderVendorCandidates(data.candidates || []);
      } catch {
        renderVendorCandidates([]);
      } finally {
        spinner.classList.add("hidden");
      }
    } else {
      renderVendorCandidates([]);
    }

    document.getElementById("vendor-selection")!.classList.remove("hidden");
  }

  function renderVendorCandidates(candidates: any[]) {
    const container = document.getElementById("vendor-candidates")!;
    container.innerHTML = "";

    if (!candidates.length) {
      container.innerHTML = `<p class="text-sm text-brand-text-muted">No matches found. Select from dropdown or create new.</p>`;
      document.getElementById("create-vendor-section")!.classList.remove("hidden");
      return;
    }

    candidates.forEach((c: any) => {
      const conf = Math.round(c.confidence * 100);
      const colorClass = c.matchLevel === "green" ? "bg-green-100 text-green-800 border-green-200" :
                         c.matchLevel === "amber" ? "bg-amber-100 text-amber-800 border-amber-200" :
                         "bg-red-100 text-red-800 border-red-200";
      const btn = document.createElement("button");
      btn.className = `w-full text-left px-4 py-3 rounded-lg border ${colorClass} hover:opacity-80 transition-opacity vendor-candidate`;
      btn.dataset.vendorId = c.vendorId;
      btn.dataset.vendorName = c.vendorName;
      btn.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="font-medium text-sm">${c.vendorName}</span>
          <span class="text-xs font-mono">${conf}%</span>
        </div>
      `;
      btn.addEventListener("click", () => selectVendor(c.vendorId, c.vendorName));
      container.appendChild(btn);
    });

    // Auto-select if top match is green (>= 90%)
    if (candidates[0]?.matchLevel === "green") {
      selectVendor(candidates[0].vendorId, candidates[0].vendorName);
    }

    // Show create option
    const createLink = document.createElement("button");
    createLink.className = "text-xs text-brand-primary hover:underline mt-1";
    createLink.textContent = "None of these? Create new vendor";
    createLink.addEventListener("click", () => {
      document.getElementById("create-vendor-section")!.classList.remove("hidden");
      const nameInput = document.getElementById("new-vendor-name") as HTMLInputElement;
      nameInput.value = extractionResult?.vendor?.name || "";
    });
    container.appendChild(createLink);
  }

  function selectVendor(id: string, name: string) {
    selectedVendorId = id;
    selectedVendorName = name;
    const select = document.getElementById("selected-vendor") as HTMLSelectElement;
    select.value = id;
    document.querySelectorAll(".vendor-candidate").forEach((el) => {
      (el as HTMLElement).style.outline = el.getAttribute("data-vendor-id") === id ? "2px solid #6366f1" : "none";
    });
    (document.getElementById("vendor-next-btn") as HTMLButtonElement).disabled = false;

    // Check for duplicate invoice
    const invoiceNum = (document.getElementById("invoice-number") as HTMLInputElement).value;
    if (invoiceNum) checkDuplicate(id, invoiceNum);
  }

  (document.getElementById("selected-vendor") as HTMLSelectElement).addEventListener("change", (e) => {
    const el = e.target as HTMLSelectElement;
    if (el.value) {
      const opt = el.options[el.selectedIndex];
      selectVendor(el.value, opt.text);
    }
  });

  async function checkDuplicate(vendorId: string, invoiceNumber: string) {
    try {
      const res = await fetch("/api/admin/inventory/po/check-duplicate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ vendorId, invoiceNumber }),
      });
      const data = await res.json();
      const warning = document.getElementById("duplicate-warning")!;
      if (data.duplicates?.length) {
        document.getElementById("duplicate-details")!.textContent =
          `Invoice #${invoiceNumber} already exists for this vendor (${data.duplicates.length} existing PO${data.duplicates.length > 1 ? "s" : ""}).`;
        warning.classList.remove("hidden");
      } else {
        warning.classList.add("hidden");
      }
    } catch {}
  }

  // Create vendor inline
  document.getElementById("create-vendor-btn")?.addEventListener("click", async () => {
    const name = (document.getElementById("new-vendor-name") as HTMLInputElement).value.trim();
    if (!name) return;
    const contact = (document.getElementById("new-vendor-contact") as HTMLInputElement).value.trim();
    const category = (document.getElementById("new-vendor-category") as HTMLInputElement).value.trim();

    const extVendor = extractionResult?.vendor || {};

    const res = await fetch("/api/admin/inventory/vendors", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name,
        contact: contact || undefined,
        category: category || undefined,
        address: extVendor.address || undefined,
        phone: extVendor.phone || undefined,
        email: extVendor.email || undefined,
      }),
    });

    if (res.ok) {
      const vendor = await res.json();
      // Add to dropdown
      const select = document.getElementById("selected-vendor") as HTMLSelectElement;
      const opt = document.createElement("option");
      opt.value = vendor.id;
      opt.text = vendor.name;
      select.add(opt);
      selectVendor(vendor.id, vendor.name);
      document.getElementById("create-vendor-section")!.classList.add("hidden");
    }
  });

  // Vendor stage next
  document.getElementById("vendor-next-btn")?.addEventListener("click", () => enterStage3());

  // ── Stage 3: Item Normalization ──
  async function enterStage3() {
    setStage(3);
    const spinner = document.getElementById("normalize-spinner")!;
    spinner.classList.remove("hidden");

    const rawItems = extractionResult.lineItems || [];

    try {
      const res = await fetch("/api/admin/inventory/po/normalize", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ lineItems: rawItems }),
      });
      if (!res.ok) throw new Error((await res.json()).error || "Normalization failed");
      const data = await res.json();
      // Merge LLM results with original extraction data to fill any gaps
      normalizedItems = (data.items || []).map((item: any, i: number) => {
        const raw = rawItems[i] || {};
        return {
          rawDescription: item.rawDescription || raw.rawDescription || raw.description || "",
          canonicalName: item.canonicalName || item.rawDescription || raw.rawDescription || "",
          category: item.category || "Other",
          baseUnit: item.baseUnit || raw.unitAsPrinted || "each",
          unitsPerPack: item.unitsPerPack ?? 1,
          packsPerCase: item.packsPerCase ?? 1,
          totalBaseUnits: item.totalBaseUnits ?? raw.qty ?? 0,
          unitCostBase: item.unitCostBase ?? raw.unitPrice ?? 0,
          confidence: item.confidence ?? 0.5,
          matchStatus: item.matchStatus || "new",
          matchedItemId: item.matchedItemId || null,
          matchedItemName: item.matchedItemName || null,
          qty: item.qty ?? raw.qty ?? 0,
          unitPrice: item.unitPrice ?? raw.unitPrice ?? 0,
          lineTotal: item.lineTotal ?? raw.lineTotal ?? 0,
        };
      });
      renderNormalizedItems();
    } catch (err: any) {
      // Fallback: show raw items without normalization
      normalizedItems = rawItems.map((li: any) => ({
        rawDescription: li.rawDescription || li.description || "",
        canonicalName: li.rawDescription || li.description || "",
        category: "Other",
        baseUnit: li.unitAsPrinted || "each",
        unitsPerPack: 1,
        packsPerCase: 1,
        totalBaseUnits: li.qty || 0,
        unitCostBase: li.unitPrice || 0,
        confidence: 0.5,
        matchStatus: "new",
        matchedItemId: null,
        matchedItemName: null,
        qty: li.qty || 0,
        unitPrice: li.unitPrice || 0,
        lineTotal: li.lineTotal || 0,
      }));
      renderNormalizedItems();
    } finally {
      spinner.classList.add("hidden");
    }
  }

  function renderNormalizedItems() {
    const tbody = document.getElementById("normalized-items-body")!;
    tbody.innerHTML = "";

    normalizedItems.forEach((item: any, i: number) => {
      const rawDesc = item.rawDescription || "";
      const canonical = item.canonicalName || rawDesc || "";
      const category = item.category || "Other";
      const qty = Number(item.qty) || 0;
      const upp = Number(item.unitsPerPack) || 1;
      const ppc = Number(item.packsPerCase) || 1;
      const baseUnit = item.baseUnit || "each";
      const totalBase = Number(item.totalBaseUnits) || 0;
      const costBase = Number(item.unitCostBase) || 0;
      const lineTotal = Number(item.lineTotal) || 0;
      const matchStatus = item.matchStatus || "new";

      const statusColor = matchStatus === "matched" ? "bg-green-100 text-green-800" :
                          matchStatus === "suggested" ? "bg-amber-100 text-amber-800" :
                          "bg-blue-100 text-blue-800";
      const tr = document.createElement("tr");
      tr.className = "border-b border-stone-100 hover:bg-stone-50";
      tr.innerHTML = `
        <td class="px-3 py-2 text-xs text-brand-text-muted max-w-[150px] truncate" title="${rawDesc}">${rawDesc}</td>
        <td class="px-3 py-2"><input type="text" value="${canonical}" data-idx="${i}" data-field="canonicalName" class="w-full border border-stone-200 rounded px-2 py-1 text-sm norm-input" /></td>
        <td class="px-3 py-2"><input type="text" value="${category}" data-idx="${i}" data-field="category" class="w-24 border border-stone-200 rounded px-2 py-1 text-sm norm-input" /></td>
        <td class="px-3 py-2 text-right font-mono text-sm">${qty}</td>
        <td class="px-3 py-2 text-xs text-brand-text-muted">${upp}×${ppc} → ${baseUnit}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">${totalBase.toFixed(1)}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">$${costBase.toFixed(4)}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">$${lineTotal.toFixed(2)}</td>
        <td class="px-3 py-2 text-center">
          <div class="flex flex-col items-center gap-1">
            <span class="px-2 py-0.5 text-[10px] font-medium rounded-full ${statusColor}">${matchStatus}</span>
            ${matchStatus !== "new" && item.matchedItemName ? `<span class="text-[10px] text-brand-text-muted">${item.matchedItemName}</span>` : ""}
            <select data-idx="${i}" data-field="matchedItemId" class="w-full border border-stone-200 rounded px-1 py-0.5 text-[11px] norm-input">
              <option value="">— Match —</option>
              <option value="__new__">+ Create New</option>
              ${existingItems.map((it: any) => `<option value="${it.id}" ${it.id === item.matchedItemId ? "selected" : ""}>${it.name} (${it.unit})</option>`).join("")}
            </select>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Attach change listeners for match dropdown
    tbody.querySelectorAll('select[data-field="matchedItemId"]').forEach((sel) => {
      sel.addEventListener("change", (e) => {
        const el = e.target as HTMLSelectElement;
        const idx = parseInt(el.dataset.idx || "0");
        if (el.value === "__new__") {
          createItemInline(idx);
          el.value = "";
        } else {
          normalizedItems[idx].matchedItemId = el.value || null;
          normalizedItems[idx].matchStatus = el.value ? "matched" : "new";
        }
      });
    });
  }

  async function createItemInline(idx: number) {
    const item = normalizedItems[idx];
    const name = item.canonicalName || item.rawDescription;
    const res = await fetch("/api/admin/inventory/items", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name,
        unit: item.baseUnit || "each",
        category: item.category || undefined,
      }),
    });
    if (res.ok) {
      const newItem = await res.json();
      existingItems.push(newItem);
      normalizedItems[idx].matchedItemId = newItem.id;
      normalizedItems[idx].matchedItemName = newItem.name;
      normalizedItems[idx].matchStatus = "matched";
      renderNormalizedItems();
    }
  }

  document.getElementById("items-back-btn")?.addEventListener("click", () => setStage(2));
  document.getElementById("items-next-btn")?.addEventListener("click", () => enterStage4());

  // ── Stage 4: Review & Confirm ──
  function enterStage4() {
    setStage(4);

    // Collect any inline edits from stage 3
    document.querySelectorAll(".norm-input").forEach((el) => {
      const idx = parseInt((el as HTMLElement).dataset.idx || "0");
      const field = (el as HTMLElement).dataset.field!;
      if (field === "matchedItemId") return; // handled by change listener
      normalizedItems[idx][field] = (el as HTMLInputElement).value;
    });

    document.getElementById("review-vendor")!.textContent = selectedVendorName || "Not selected";
    document.getElementById("review-invoice-num")!.textContent = (document.getElementById("invoice-number") as HTMLInputElement).value || "—";
    document.getElementById("review-date")!.textContent = (document.getElementById("invoice-date") as HTMLInputElement).value || "—";
    document.getElementById("review-due-date")!.textContent = (document.getElementById("invoice-due-date") as HTMLInputElement).value || "—";

    const tbody = document.getElementById("review-items-body")!;
    tbody.innerHTML = "";
    let subtotal = 0;

    normalizedItems.forEach((item: any) => {
      const lineTotal = Number(item.lineTotal) || 0;
      const totalBase = Number(item.totalBaseUnits) || 0;
      const costBase = Number(item.unitCostBase) || 0;
      const qty = Number(item.qty) || 0;
      subtotal += lineTotal;
      const ms = item.matchStatus || "new";
      const statusColor = ms === "matched" ? "bg-green-100 text-green-800" :
                          ms === "suggested" ? "bg-amber-100 text-amber-800" :
                          "bg-stone-100 text-stone-600";
      const tr = document.createElement("tr");
      tr.className = "border-b border-stone-100";
      tr.innerHTML = `
        <td class="px-3 py-2 text-sm font-medium text-brand-text-heading">${item.canonicalName || item.rawDescription || ""}</td>
        <td class="px-3 py-2 text-sm text-brand-text-muted">${item.category || "Other"}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">${qty}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">${totalBase.toFixed(1)} ${item.baseUnit || "each"}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">$${costBase.toFixed(4)}</td>
        <td class="px-3 py-2 text-right font-mono text-sm">$${lineTotal.toFixed(2)}</td>
        <td class="px-3 py-2 text-center"><span class="px-2 py-0.5 text-[10px] font-medium rounded-full ${statusColor}">${ms}</span></td>
      `;
      tbody.appendChild(tr);
    });

    document.getElementById("review-subtotal")!.textContent = `$${subtotal.toFixed(2)}`;

    // Set freight/tax from extraction
    const totals = extractionResult.totals || {};
    (document.getElementById("review-freight") as HTMLInputElement).value = (totals.freight || 0).toString();
    (document.getElementById("review-tax") as HTMLInputElement).value = (totals.tax || 0).toString();
    updateReviewTotal();

    // Check total mismatch
    const invoiceTotal = totals.total || 0;
    const calculatedTotal = subtotal + (totals.freight || 0) + (totals.tax || 0);
    if (invoiceTotal > 0 && Math.abs(invoiceTotal - calculatedTotal) > 0.02) {
      document.getElementById("total-mismatch")!.classList.remove("hidden");
    }
  }

  function updateReviewTotal() {
    const subtotalText = document.getElementById("review-subtotal")!.textContent || "$0.00";
    const subtotal = parseFloat(subtotalText.replace("$", ""));
    const freight = parseFloat((document.getElementById("review-freight") as HTMLInputElement).value) || 0;
    const tax = parseFloat((document.getElementById("review-tax") as HTMLInputElement).value) || 0;
    document.getElementById("review-total")!.textContent = `$${(subtotal + freight + tax).toFixed(2)}`;
  }

  document.getElementById("review-freight")?.addEventListener("input", updateReviewTotal);
  document.getElementById("review-tax")?.addEventListener("input", updateReviewTotal);

  document.getElementById("review-back-btn")?.addEventListener("click", () => setStage(3));

  // ── Confirm PO ──
  document.getElementById("confirm-po-btn")?.addEventListener("click", async () => {
    const btn = document.getElementById("confirm-po-btn") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Saving...";

    const invoiceNumber = (document.getElementById("invoice-number") as HTMLInputElement).value;
    const orderDate = (document.getElementById("invoice-date") as HTMLInputElement).value;
    const dueDate = (document.getElementById("invoice-due-date") as HTMLInputElement).value;
    const poReference = (document.getElementById("invoice-po-ref") as HTMLInputElement).value;
    const freight = (document.getElementById("review-freight") as HTMLInputElement).value;
    const tax = (document.getElementById("review-tax") as HTMLInputElement).value;
    const paymentStatus = (document.getElementById("review-payment-status") as HTMLSelectElement).value;
    const receivingNotes = (document.getElementById("review-notes") as HTMLTextAreaElement).value;

    const subtotal = normalizedItems.reduce((sum: number, li: any) => sum + (Number(li.lineTotal) || 0), 0);
    const totalCost = (subtotal + parseFloat(freight || "0") + parseFloat(tax || "0")).toFixed(2);

    const lineItems = normalizedItems.map((li: any) => ({
      description: li.canonicalName || li.rawDescription,
      qty: li.qty.toString(),
      unitCost: li.unitPrice?.toString(),
      totalCost: li.lineTotal?.toString(),
      itemId: li.matchedItemId || undefined,
      rawDescription: li.rawDescription,
      canonicalName: li.canonicalName,
      category: li.category,
      baseUnit: li.baseUnit,
      unitsPerPack: li.unitsPerPack?.toString(),
      packsPerCase: li.packsPerCase?.toString(),
      totalBaseUnits: li.totalBaseUnits?.toString(),
      unitCostBase: li.unitCostBase?.toString(),
      confidence: li.confidence?.toString(),
      matchStatus: li.matchStatus,
    }));

    const msgEl = document.getElementById("confirm-msg")!;

    try {
      // Step 1: Create draft PO
      const createRes = await fetch("/api/admin/inventory/po", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          vendorId: selectedVendorId || undefined,
          orderDate,
          totalCost,
          rawDocUrl,
          rawDocS3Key,
          status: "draft",
          invoiceNumber: invoiceNumber || undefined,
          dueDate: dueDate || undefined,
          poReference: poReference || undefined,
          subtotal: subtotal.toFixed(2),
          freight: freight || undefined,
          tax: tax || undefined,
          paymentStatus,
          receivingNotes: receivingNotes || undefined,
          lineItems,
        }),
      });

      if (!createRes.ok) throw new Error((await createRes.json()).error || "Failed to create PO");
      const po = await createRes.json();

      // Step 2: Confirm (updates inventory)
      const confirmRes = await fetch(`/api/admin/inventory/po/${po.id}/confirm`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ paymentStatus, receivingNotes }),
      });

      if (!confirmRes.ok) throw new Error("PO created but confirmation failed");

      msgEl.textContent = "Purchase order confirmed! Inventory updated. Redirecting...";
      msgEl.className = "text-sm text-green-600";
      msgEl.classList.remove("hidden");
      setTimeout(() => { window.location.href = "/admin/inventory/purchase-orders"; }, 1500);
    } catch (err: any) {
      msgEl.textContent = err.message;
      msgEl.className = "text-sm text-red-600";
      msgEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Confirm Purchase Order";
    }
  });
</script>
