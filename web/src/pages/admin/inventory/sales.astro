---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let menuItems: any[] = [];
let salesEntries: any[] = [];
try {
  const [miRes, sRes] = await Promise.all([
    fetch(`${apiUrl}/api/admin/inventory/menu-items`, { headers: { cookie } }),
    fetch(`${apiUrl}/api/admin/inventory/sales`, { headers: { cookie } }),
  ]);
  if (miRes.ok) menuItems = await miRes.json();
  if (sRes.ok) salesEntries = await sRes.json();
} catch {}
---

<AdminLayout title="Sales Entry" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Log daily sales to track ingredient usage.</p>
  </div>

  <InventoryNav active="sales" />

  <!-- CSV Upload -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 mb-6">
    <div class="flex items-center justify-between mb-1">
      <h2 class="font-heading font-semibold text-brand-text-heading">Upload CSV</h2>
      <a href="/test-data/sample-pos-export.csv" download class="text-xs text-brand-primary hover:underline">Download sample CSV</a>
    </div>
    <p class="text-xs text-brand-text-muted mb-3">Import sales from a POS export. CSV must have <code class="bg-stone-100 px-1 rounded">date</code>, <code class="bg-stone-100 px-1 rounded">item</code>, and <code class="bg-stone-100 px-1 rounded">qty</code> columns.</p>

    <div id="csv-dropzone" class="border-2 border-dashed border-stone-300 rounded-lg p-6 text-center cursor-pointer hover:border-brand-primary hover:bg-brand-primary/5 transition-colors">
      <svg class="w-8 h-8 mx-auto text-stone-400 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
      <p class="text-sm text-brand-text-muted">Drop a CSV file here or <span class="text-brand-primary font-medium">click to browse</span></p>
      <input type="file" id="csv-input" accept=".csv" class="hidden" />
    </div>

    <div id="csv-status" class="mt-3 hidden">
      <div class="flex items-center gap-2">
        <div class="w-4 h-4 border-2 border-purple-600 border-t-transparent rounded-full animate-spin"></div>
        <span class="text-sm text-brand-text-muted">AI is matching items...</span>
      </div>
    </div>

    <!-- CSV Preview -->
    <div id="csv-preview" class="mt-4 hidden">
      <div id="csv-summary" class="flex gap-4 mb-3 text-sm"></div>
      <div class="overflow-x-auto border border-stone-200 rounded-lg mb-3 max-h-[400px] overflow-y-auto">
        <table class="w-full text-sm">
          <thead class="sticky top-0">
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Date</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">CSV Item</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Qty</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Matched To</th>
              <th class="text-center px-3 py-2 text-xs font-medium text-brand-text-muted">Status</th>
            </tr>
          </thead>
          <tbody id="csv-preview-body"></tbody>
        </table>
      </div>
      <div class="flex items-center gap-3">
        <button id="csv-import-btn" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">Import Sales</button>
        <button id="csv-cancel-btn" class="px-4 py-2 border border-stone-300 rounded-lg text-sm font-medium text-brand-text-body hover:bg-stone-50 transition-colors">Cancel</button>
        <p id="csv-msg" class="text-sm hidden"></p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- NLP Entry -->
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="font-heading font-semibold text-brand-text-heading mb-1">Quick Entry (AI)</h2>
      <p class="text-xs text-brand-text-muted mb-3">Type sales in natural language, e.g. "20 Reuben, 15 Coney Dog, 8 Greek Salad"</p>
      <textarea id="nlp-input" rows="3" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" placeholder="Enter sales..."></textarea>
      <button id="parse-btn" class="mt-2 px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-medium hover:bg-purple-700 transition-colors">
        Parse with AI
      </button>
      <div id="parse-status" class="mt-2 hidden">
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 border-2 border-purple-600 border-t-transparent rounded-full animate-spin"></div>
          <span class="text-sm text-brand-text-muted">Parsing...</span>
        </div>
      </div>
    </div>

    <!-- Manual / Parsed Entry -->
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="font-heading font-semibold text-brand-text-heading mb-3">Sales Lines</h2>
      <div class="mb-3">
        <label class="block text-xs font-medium text-brand-text-muted mb-1">Sale Date</label>
        <input type="date" id="sale-date" class="border border-stone-300 rounded-lg px-3 py-2 text-sm" />
      </div>
      <div class="overflow-x-auto border border-stone-200 rounded-lg mb-3">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Menu Item</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Qty Sold</th>
              <th class="w-10"></th>
            </tr>
          </thead>
          <tbody id="sales-body"></tbody>
        </table>
      </div>
      <div class="flex gap-2">
        <button id="add-sale-row" class="px-3 py-1.5 border border-stone-300 rounded-lg text-xs font-medium text-brand-text-body hover:bg-stone-50 transition-colors">+ Add Row</button>
        <button id="submit-sales" class="px-4 py-1.5 bg-brand-primary text-white rounded-lg text-xs font-medium hover:bg-brand-primary-dark transition-colors">Submit Sales</button>
      </div>
      <p id="sales-msg" class="text-sm mt-2 hidden"></p>
    </div>
  </div>

  <!-- Sales History -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200">
    <div class="px-6 py-4 border-b border-stone-200">
      <h2 class="font-heading font-semibold text-brand-text-heading">Recent Sales Entries</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Date</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Items</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Notes</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {salesEntries.map((e) => (
            <tr class="hover:bg-stone-50">
              <td class="px-6 py-3 text-brand-text-body">{new Date(e.saleDate).toLocaleDateString("en-US", { month: "short", day: "numeric" })}</td>
              <td class="px-6 py-3 text-brand-text-body">
                {(e.lines || []).map((l: any) => `${l.qtySold}x ${l.menuItem?.name || "?"}`).join(", ") || "—"}
              </td>
              <td class="px-6 py-3 text-brand-text-muted text-xs">{e.notes || "—"}</td>
              <td class="px-6 py-3 text-right">
                <button class="delete-sale text-red-600 hover:text-red-800 text-xs font-medium" data-id={e.id}>Delete</button>
              </td>
            </tr>
          ))}
          {salesEntries.length === 0 && (
            <tr><td colspan="4" class="px-6 py-8 text-center text-brand-text-muted">No sales entries yet.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script type="application/json" id="menu-items-data" set:html={JSON.stringify(menuItems)}></script>
</AdminLayout>

<script>
  const menuItems = JSON.parse(document.getElementById("menu-items-data")?.textContent || "[]");

  const tbody = document.getElementById("sales-body")!;
  const dateInput = document.getElementById("sale-date") as HTMLInputElement;
  dateInput.value = new Date().toISOString().split("T")[0];

  function addSaleRow(menuItemId?: string, qty?: number) {
    const tr = document.createElement("tr");
    tr.className = "border-b border-stone-100 sale-row";
    tr.innerHTML = `
      <td class="px-3 py-2">
        <select class="s-item w-full border border-stone-200 rounded px-2 py-1 text-sm">
          <option value="">— Select —</option>
          ${menuItems.map((mi: any) => `<option value="${mi.id}" ${menuItemId === mi.id ? "selected" : ""}>${mi.name}</option>`).join("")}
        </select>
      </td>
      <td class="px-3 py-2 text-right">
        <input type="number" value="${qty || ''}" min="1" class="s-qty w-20 border border-stone-200 rounded px-2 py-1 text-sm text-right" />
      </td>
      <td class="px-3 py-1">
        <button class="remove-sale-row text-red-500 hover:text-red-700 text-lg">&times;</button>
      </td>
    `;
    tr.querySelector(".remove-sale-row")!.addEventListener("click", () => tr.remove());
    tbody.appendChild(tr);
  }

  document.getElementById("add-sale-row")?.addEventListener("click", () => addSaleRow());

  document.getElementById("parse-btn")?.addEventListener("click", async () => {
    const text = (document.getElementById("nlp-input") as HTMLTextAreaElement).value.trim();
    if (!text) return;

    const status = document.getElementById("parse-status")!;
    status.classList.remove("hidden");

    try {
      const res = await fetch("/api/admin/inventory/sales/parse", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text }),
      });
      if (!res.ok) throw new Error("Parse failed");
      const data = await res.json();

      tbody.innerHTML = "";
      (data.items || []).forEach((item: any) => {
        addSaleRow(item.menuItemId, item.qty);
      });
    } catch {
      alert("Failed to parse sales text");
    } finally {
      status.classList.add("hidden");
    }
  });

  document.getElementById("submit-sales")?.addEventListener("click", async () => {
    const rows = document.querySelectorAll(".sale-row");
    const lines: any[] = [];
    rows.forEach((row) => {
      const menuItemId = (row.querySelector(".s-item") as HTMLSelectElement).value;
      const qtySold = parseInt((row.querySelector(".s-qty") as HTMLInputElement).value);
      if (menuItemId && qtySold > 0) lines.push({ menuItemId, qtySold });
    });

    if (lines.length === 0) { alert("Add at least one sales line"); return; }

    const nlpText = (document.getElementById("nlp-input") as HTMLTextAreaElement).value.trim();

    const res = await fetch("/api/admin/inventory/sales", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        saleDate: dateInput.value,
        notes: nlpText || undefined,
        lines,
      }),
    });

    const msg = document.getElementById("sales-msg")!;
    if (res.ok) {
      msg.textContent = "Sales entry recorded! Inventory updated.";
      msg.className = "text-sm mt-2 text-green-600";
      setTimeout(() => { window.location.reload(); }, 800);
    } else {
      const err = await res.json();
      msg.textContent = err.error || "Failed to submit sales";
      msg.className = "text-sm mt-2 text-red-600";
    }
  });

  document.querySelectorAll(".delete-sale").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Delete this sales entry?")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/sales/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
    });
  });

  // ── CSV Upload ──
  const csvDropzone = document.getElementById("csv-dropzone")!;
  const csvInput = document.getElementById("csv-input") as HTMLInputElement;
  const csvStatus = document.getElementById("csv-status")!;
  const csvPreview = document.getElementById("csv-preview")!;
  const csvPreviewBody = document.getElementById("csv-preview-body")!;
  const csvSummary = document.getElementById("csv-summary")!;

  let csvData: any = null; // stored preview response

  csvDropzone.addEventListener("click", () => csvInput.click());
  csvDropzone.addEventListener("dragover", (e) => { e.preventDefault(); csvDropzone.classList.add("border-brand-primary", "bg-brand-primary/5"); });
  csvDropzone.addEventListener("dragleave", () => { csvDropzone.classList.remove("border-brand-primary", "bg-brand-primary/5"); });
  csvDropzone.addEventListener("drop", (e) => {
    e.preventDefault();
    csvDropzone.classList.remove("border-brand-primary", "bg-brand-primary/5");
    const file = (e as DragEvent).dataTransfer?.files[0];
    if (file) uploadCSV(file);
  });
  csvInput.addEventListener("change", () => {
    if (csvInput.files?.[0]) uploadCSV(csvInput.files[0]);
  });

  async function uploadCSV(file: File) {
    csvStatus.classList.remove("hidden");
    csvPreview.classList.add("hidden");

    const formData = new FormData();
    formData.append("file", file);

    try {
      const res = await fetch("/api/admin/inventory/sales/upload-csv", { method: "POST", body: formData });
      if (!res.ok) { const err = await res.json(); throw new Error(err.error || "Upload failed"); }
      csvData = await res.json();
      renderCSVPreview();
    } catch (err: any) {
      alert(err.message || "Failed to upload CSV");
    } finally {
      csvStatus.classList.add("hidden");
      csvInput.value = "";
    }
  }

  function renderCSVPreview() {
    if (!csvData) return;
    csvPreview.classList.remove("hidden");
    csvDropzone.classList.add("hidden");

    const s = csvData.summary;
    csvSummary.innerHTML = `
      <span class="px-2 py-1 bg-stone-100 rounded text-xs font-medium">${s.totalRows} rows</span>
      <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-medium">${s.matched} matched</span>
      ${s.unmatched > 0 ? `<span class="px-2 py-1 bg-amber-100 text-amber-800 rounded text-xs font-medium">${s.unmatched} unmatched</span>` : ""}
      <span class="px-2 py-1 bg-stone-100 rounded text-xs font-medium">${s.dates.length} date${s.dates.length !== 1 ? "s" : ""}</span>
    `;

    csvPreviewBody.innerHTML = "";
    const allMenuItems = csvData.menuItems || [];

    csvData.preview.forEach((row: any, idx: number) => {
      const tr = document.createElement("tr");
      tr.className = row.matchStatus === "unmatched" ? "bg-amber-50/50 border-b border-stone-100" : "border-b border-stone-100";
      tr.dataset.idx = String(idx);

      if (row.matchStatus === "matched") {
        tr.innerHTML = `
          <td class="px-3 py-2 text-brand-text-body">${row.date}</td>
          <td class="px-3 py-2 text-brand-text-body">${row.item}${row.modifications ? `<span class="text-[10px] text-brand-text-muted ml-1">(${row.modifications})</span>` : ""}</td>
          <td class="px-3 py-2 text-right text-brand-text-body">${row.qty}</td>
          <td class="px-3 py-2 text-brand-text-body">${row.menuItemName}</td>
          <td class="px-3 py-2 text-center"><span class="px-1.5 py-0.5 text-[10px] font-medium bg-green-100 text-green-700 rounded-full">Matched</span></td>
        `;
      } else {
        tr.innerHTML = `
          <td class="px-3 py-2 text-amber-800">${row.date}</td>
          <td class="px-3 py-2 text-amber-800 font-medium">${row.item}${row.modifications ? `<span class="text-[10px] text-amber-600 ml-1">(${row.modifications})</span>` : ""}</td>
          <td class="px-3 py-2 text-right text-amber-800">${row.qty}</td>
          <td class="px-3 py-2">
            <div class="flex items-center gap-1">
              <select class="csv-remap flex-1 border border-amber-300 rounded px-2 py-1 text-sm bg-white" data-idx="${idx}">
                <option value="">— Skip —</option>
                ${allMenuItems.map((mi: any) => `<option value="${mi.id}">${mi.name}</option>`).join("")}
              </select>
              <button class="csv-add-menu shrink-0 px-2 py-1 text-[10px] font-medium bg-brand-primary text-white rounded hover:bg-brand-primary-dark transition-colors" data-idx="${idx}" data-name="${row.item}">+ Add</button>
            </div>
          </td>
          <td class="px-3 py-2 text-center"><span class="px-1.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 rounded-full">Unmatched</span></td>
        `;
        // "Add to Menu" handler
        tr.querySelector(".csv-add-menu")!.addEventListener("click", async (e) => {
          const btn = e.target as HTMLButtonElement;
          const itemName = btn.dataset.name!;
          const rowIdx = parseInt(btn.dataset.idx!);
          btn.textContent = "Adding...";
          btn.disabled = true;
          try {
            const res = await fetch("/api/admin/inventory/menu-items", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name: itemName }),
            });
            if (!res.ok) throw new Error("Failed");
            const newItem = await res.json();
            // Update local data so import picks it up
            allMenuItems.push({ id: newItem.id, name: newItem.name });
            csvData.preview[rowIdx].menuItemId = newItem.id;
            csvData.preview[rowIdx].menuItemName = newItem.name;
            csvData.preview[rowIdx].matchStatus = "matched";
            // Also match all other rows with the same item name
            csvData.preview.forEach((p: any, i: number) => {
              if (i !== rowIdx && p.item === itemName && p.matchStatus === "unmatched") {
                p.menuItemId = newItem.id;
                p.menuItemName = newItem.name;
                p.matchStatus = "matched";
              }
            });
            // Update summary counts
            csvData.summary.matched = csvData.preview.filter((p: any) => p.matchStatus === "matched").length;
            csvData.summary.unmatched = csvData.preview.filter((p: any) => p.matchStatus === "unmatched").length;
            // Re-render the whole preview
            renderCSVPreview();
          } catch {
            btn.textContent = "Failed";
            btn.classList.replace("bg-brand-primary", "bg-red-500");
          }
        });
      }
      csvPreviewBody.appendChild(tr);
    });
  }

  document.getElementById("csv-cancel-btn")?.addEventListener("click", () => {
    csvPreview.classList.add("hidden");
    csvDropzone.classList.remove("hidden");
    csvData = null;
  });

  document.getElementById("csv-import-btn")?.addEventListener("click", async () => {
    if (!csvData) return;
    const msg = document.getElementById("csv-msg")!;
    const btn = document.getElementById("csv-import-btn") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Importing...";

    // Build import lines: matched + manually remapped
    const lines: Array<{ date: string; menuItemId: string; qty: number }> = [];
    csvData.preview.forEach((row: any, idx: number) => {
      let menuItemId = row.menuItemId;
      if (!menuItemId) {
        const select = csvPreviewBody.querySelector(`select[data-idx="${idx}"]`) as HTMLSelectElement | null;
        menuItemId = select?.value || null;
      }
      if (menuItemId) {
        lines.push({ date: row.date, menuItemId, qty: row.qty });
      }
    });

    if (lines.length === 0) { alert("No matched items to import"); btn.disabled = false; btn.textContent = "Import Sales"; return; }

    try {
      const res = await fetch("/api/admin/inventory/sales/import-csv", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ lines }),
      });
      if (!res.ok) { const err = await res.json(); throw new Error(err.error || "Import failed"); }
      const data = await res.json();
      msg.textContent = `Imported ${lines.length} items across ${data.entriesCreated} date(s)!`;
      msg.className = "text-sm text-green-600";
      msg.classList.remove("hidden");
      setTimeout(() => { window.location.reload(); }, 1200);
    } catch (err: any) {
      msg.textContent = err.message || "Import failed";
      msg.className = "text-sm text-red-600";
      msg.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Import Sales";
    }
  });
</script>
