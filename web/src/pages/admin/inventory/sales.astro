---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let menuItems: any[] = [];
let salesEntries: any[] = [];
try {
  const [miRes, sRes] = await Promise.all([
    fetch(`${apiUrl}/api/admin/inventory/menu-items`, { headers: { cookie } }),
    fetch(`${apiUrl}/api/admin/inventory/sales`, { headers: { cookie } }),
  ]);
  if (miRes.ok) menuItems = await miRes.json();
  if (sRes.ok) salesEntries = await sRes.json();
} catch {}
---

<AdminLayout title="Sales Entry" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Log daily sales to track ingredient usage.</p>
  </div>

  <InventoryNav active="sales" />

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- NLP Entry -->
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="font-heading font-semibold text-brand-text-heading mb-1">Quick Entry (AI)</h2>
      <p class="text-xs text-brand-text-muted mb-3">Type sales in natural language, e.g. "20 Reuben, 15 Coney Dog, 8 Greek Salad"</p>
      <textarea id="nlp-input" rows="3" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" placeholder="Enter sales..."></textarea>
      <button id="parse-btn" class="mt-2 px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-medium hover:bg-purple-700 transition-colors">
        Parse with AI
      </button>
      <div id="parse-status" class="mt-2 hidden">
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 border-2 border-purple-600 border-t-transparent rounded-full animate-spin"></div>
          <span class="text-sm text-brand-text-muted">Parsing...</span>
        </div>
      </div>
    </div>

    <!-- Manual / Parsed Entry -->
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="font-heading font-semibold text-brand-text-heading mb-3">Sales Lines</h2>
      <div class="mb-3">
        <label class="block text-xs font-medium text-brand-text-muted mb-1">Sale Date</label>
        <input type="date" id="sale-date" class="border border-stone-300 rounded-lg px-3 py-2 text-sm" />
      </div>
      <div class="overflow-x-auto border border-stone-200 rounded-lg mb-3">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-3 py-2 text-xs font-medium text-brand-text-muted">Menu Item</th>
              <th class="text-right px-3 py-2 text-xs font-medium text-brand-text-muted">Qty Sold</th>
              <th class="w-10"></th>
            </tr>
          </thead>
          <tbody id="sales-body"></tbody>
        </table>
      </div>
      <div class="flex gap-2">
        <button id="add-sale-row" class="px-3 py-1.5 border border-stone-300 rounded-lg text-xs font-medium text-brand-text-body hover:bg-stone-50 transition-colors">+ Add Row</button>
        <button id="submit-sales" class="px-4 py-1.5 bg-brand-primary text-white rounded-lg text-xs font-medium hover:bg-brand-primary-dark transition-colors">Submit Sales</button>
      </div>
      <p id="sales-msg" class="text-sm mt-2 hidden"></p>
    </div>
  </div>

  <!-- Sales History -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200">
    <div class="px-6 py-4 border-b border-stone-200">
      <h2 class="font-heading font-semibold text-brand-text-heading">Recent Sales Entries</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Date</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Items</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Notes</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {salesEntries.map((e) => (
            <tr class="hover:bg-stone-50">
              <td class="px-6 py-3 text-brand-text-body">{new Date(e.saleDate).toLocaleDateString("en-US", { month: "short", day: "numeric" })}</td>
              <td class="px-6 py-3 text-brand-text-body">
                {(e.lines || []).map((l: any) => `${l.qtySold}x ${l.menuItem?.name || "?"}`).join(", ") || "—"}
              </td>
              <td class="px-6 py-3 text-brand-text-muted text-xs">{e.notes || "—"}</td>
              <td class="px-6 py-3 text-right">
                <button class="delete-sale text-red-600 hover:text-red-800 text-xs font-medium" data-id={e.id}>Delete</button>
              </td>
            </tr>
          ))}
          {salesEntries.length === 0 && (
            <tr><td colspan="4" class="px-6 py-8 text-center text-brand-text-muted">No sales entries yet.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ menuItems }}>
  const tbody = document.getElementById("sales-body")!;
  const dateInput = document.getElementById("sale-date") as HTMLInputElement;
  dateInput.value = new Date().toISOString().split("T")[0];

  function addSaleRow(menuItemId?: string, qty?: number) {
    const tr = document.createElement("tr");
    tr.className = "border-b border-stone-100 sale-row";
    tr.innerHTML = `
      <td class="px-3 py-2">
        <select class="s-item w-full border border-stone-200 rounded px-2 py-1 text-sm">
          <option value="">— Select —</option>
          ${menuItems.map((mi: any) => `<option value="${mi.id}" ${menuItemId === mi.id ? "selected" : ""}>${mi.name}</option>`).join("")}
        </select>
      </td>
      <td class="px-3 py-2 text-right">
        <input type="number" value="${qty || ''}" min="1" class="s-qty w-20 border border-stone-200 rounded px-2 py-1 text-sm text-right" />
      </td>
      <td class="px-3 py-1">
        <button class="remove-sale-row text-red-500 hover:text-red-700 text-lg">&times;</button>
      </td>
    `;
    tr.querySelector(".remove-sale-row")!.addEventListener("click", () => tr.remove());
    tbody.appendChild(tr);
  }

  document.getElementById("add-sale-row")?.addEventListener("click", () => addSaleRow());

  // AI Parse
  document.getElementById("parse-btn")?.addEventListener("click", async () => {
    const text = (document.getElementById("nlp-input") as HTMLTextAreaElement).value.trim();
    if (!text) return;

    const status = document.getElementById("parse-status")!;
    status.classList.remove("hidden");

    try {
      const res = await fetch("/api/admin/inventory/sales/parse", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text }),
      });
      if (!res.ok) throw new Error("Parse failed");
      const data = await res.json();

      tbody.innerHTML = "";
      (data.items || []).forEach((item: any) => {
        addSaleRow(item.menuItemId, item.qty);
      });
    } catch {
      alert("Failed to parse sales text");
    } finally {
      status.classList.add("hidden");
    }
  });

  // Submit
  document.getElementById("submit-sales")?.addEventListener("click", async () => {
    const rows = document.querySelectorAll(".sale-row");
    const lines: any[] = [];
    rows.forEach((row) => {
      const menuItemId = (row.querySelector(".s-item") as HTMLSelectElement).value;
      const qtySold = parseInt((row.querySelector(".s-qty") as HTMLInputElement).value);
      if (menuItemId && qtySold > 0) lines.push({ menuItemId, qtySold });
    });

    if (lines.length === 0) { alert("Add at least one sales line"); return; }

    const nlpText = (document.getElementById("nlp-input") as HTMLTextAreaElement).value.trim();

    const res = await fetch("/api/admin/inventory/sales", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        saleDate: dateInput.value,
        notes: nlpText || undefined,
        lines,
      }),
    });

    const msg = document.getElementById("sales-msg")!;
    if (res.ok) {
      msg.textContent = "Sales entry recorded! Inventory updated.";
      msg.className = "text-sm mt-2 text-green-600";
      setTimeout(() => window.location.reload(), 800);
    } else {
      const err = await res.json();
      msg.textContent = err.error || "Failed to submit sales";
      msg.className = "text-sm mt-2 text-red-600";
    }
  });

  // Delete
  document.querySelectorAll(".delete-sale").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Delete this sales entry?")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/sales/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
    });
  });
</script>
