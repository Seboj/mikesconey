---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let vendors: any[] = [];
try {
  const res = await fetch(`${apiUrl}/api/admin/inventory/vendors`, { headers: { cookie } });
  if (res.ok) vendors = await res.json();
} catch {}
---

<AdminLayout title="Vendors" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Manage your vendors and suppliers.</p>
  </div>

  <InventoryNav active="vendors" />

  <!-- Add Vendor Form -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 mb-6">
    <h2 class="font-heading font-semibold text-brand-text-heading mb-4">Add Vendor</h2>
    <form id="add-vendor-form" class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-brand-text-muted mb-1">Name *</label>
        <input type="text" name="name" required class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" />
      </div>
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-brand-text-muted mb-1">Contact</label>
        <input type="text" name="contact" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" />
      </div>
      <div class="w-40">
        <label class="block text-xs font-medium text-brand-text-muted mb-1">Category</label>
        <input type="text" name="category" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" />
      </div>
      <button type="submit" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">Add</button>
    </form>
    <p id="vendor-msg" class="text-sm mt-2 hidden"></p>
  </div>

  <!-- Vendors Table -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Name</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Contact</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Category</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="vendors-body" class="divide-y divide-stone-100">
          {vendors.map((v) => (
            <tr class="hover:bg-stone-50" data-id={v.id}>
              <td class="px-6 py-3 font-medium text-brand-text-heading">{v.name}</td>
              <td class="px-6 py-3 text-brand-text-body">{v.contact || "—"}</td>
              <td class="px-6 py-3 text-brand-text-body">{v.category || "—"}</td>
              <td class="px-6 py-3 text-right">
                <button class="delete-vendor text-red-600 hover:text-red-800 text-xs font-medium" data-id={v.id}>Delete</button>
              </td>
            </tr>
          ))}
          {vendors.length === 0 && (
            <tr><td colspan="4" class="px-6 py-8 text-center text-brand-text-muted">No vendors yet. Add one above.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.getElementById("add-vendor-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));
    const msg = document.getElementById("vendor-msg")!;

    const res = await fetch("/api/admin/inventory/vendors", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json();
      msg.textContent = err.error || "Failed to add vendor";
      msg.className = "text-sm mt-2 text-red-600";
    }
  });

  document.querySelectorAll(".delete-vendor").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Delete this vendor?")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/vendors/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
    });
  });
</script>
