---
export const prerender = false;

import AdminLayout from "../../../components/admin/AdminLayout.astro";
import InventoryNav from "../../../components/admin/InventoryNav.astro";

const apiUrl = process.env.API_URL || "http://localhost:3000";
const cookie = Astro.request.headers.get("cookie") || "";

let vendors: any[] = [];
try {
  const res = await fetch(`${apiUrl}/api/admin/inventory/vendors`, { headers: { cookie } });
  if (res.ok) vendors = await res.json();
} catch {}
---

<AdminLayout title="Vendors" activePage="inventory">
  <div class="mb-6">
    <h1 class="font-heading text-2xl font-bold text-brand-text-heading">Inventory</h1>
    <p class="text-sm text-brand-text-muted mt-1">Manage your vendors and suppliers.</p>
  </div>

  <InventoryNav active="vendors" />

  <!-- Add Vendor Button -->
  <div class="flex gap-3 mb-4">
    <button id="show-add-form" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">
      + Add Vendor
    </button>
  </div>

  <!-- Vendors Table -->
  <div class="bg-white rounded-xl shadow-sm border border-stone-200">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Name</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Contact</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Phone</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Category</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Terms</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Last Order</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-brand-text-muted uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="vendors-body" class="divide-y divide-stone-100">
          {vendors.map((v) => (
            <tr class="hover:bg-stone-50 cursor-pointer vendor-row" data-id={v.id}>
              <td class="px-6 py-3 font-medium text-brand-text-heading">{v.name}</td>
              <td class="px-6 py-3 text-brand-text-body">{v.contact || "—"}</td>
              <td class="px-6 py-3 text-brand-text-body">{v.phone || "—"}</td>
              <td class="px-6 py-3 text-brand-text-body">{v.category || "—"}</td>
              <td class="px-6 py-3 text-brand-text-body">{v.paymentTerms || "—"}</td>
              <td class="px-6 py-3 text-brand-text-muted text-xs">{v.lastOrderDate ? new Date(v.lastOrderDate).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "—"}</td>
              <td class="px-6 py-3 text-right space-x-2">
                <button class="edit-vendor text-brand-primary hover:text-brand-primary-dark text-xs font-medium" data-id={v.id}>Edit</button>
                <button class="delete-vendor text-red-600 hover:text-red-800 text-xs font-medium" data-id={v.id}>Delete</button>
              </td>
            </tr>
          ))}
          {vendors.length === 0 && (
            <tr><td colspan="7" class="px-6 py-8 text-center text-brand-text-muted">No vendors yet. Click "+ Add Vendor" to get started.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit/Add Panel (slide-over) -->
  <div id="vendor-panel" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/30" id="panel-backdrop"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-lg bg-white shadow-xl overflow-y-auto">
      <div class="px-6 py-4 border-b border-stone-200 flex items-center justify-between">
        <h2 id="panel-title" class="font-heading font-semibold text-brand-text-heading">Add Vendor</h2>
        <button id="close-panel" class="text-stone-400 hover:text-stone-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="vendor-form" class="p-6 space-y-4">
        <input type="hidden" id="vf-id" value="" />
        <div>
          <label class="block text-xs font-medium text-brand-text-muted mb-1">Name *</label>
          <input type="text" id="vf-name" required class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Contact Person</label>
            <input type="text" id="vf-contact" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Category</label>
            <input type="text" id="vf-category" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Phone</label>
            <input type="text" id="vf-phone" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-brand-text-muted mb-1">Email</label>
            <input type="email" id="vf-email" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-brand-text-muted mb-1">Address</label>
          <input type="text" id="vf-address" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-medium text-brand-text-muted mb-1">Payment Terms</label>
          <input type="text" id="vf-terms" placeholder="e.g. Net 30, COD" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-medium text-brand-text-muted mb-1">Notes</label>
          <textarea id="vf-notes" rows="3" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" placeholder="Delivery schedule, account number, etc."></textarea>
        </div>
        <div class="flex gap-2 pt-2">
          <button type="submit" id="vf-submit" class="flex-1 px-4 py-2.5 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors">Save</button>
          <button type="button" id="vf-cancel" class="px-4 py-2.5 border border-stone-300 rounded-lg text-sm text-brand-text-body hover:bg-stone-50">Cancel</button>
        </div>
        <p id="vf-msg" class="text-sm hidden"></p>
      </form>
    </div>
  </div>

  <script type="application/json" id="vendors-data" set:html={JSON.stringify(vendors)}></script>
</AdminLayout>

<script>
  const vendorsData = JSON.parse(document.getElementById("vendors-data")?.textContent || "[]");
  const panel = document.getElementById("vendor-panel")!;

  function openPanel(vendor?: any) {
    const title = document.getElementById("panel-title")!;
    const submitBtn = document.getElementById("vf-submit")!;

    if (vendor) {
      title.textContent = "Edit Vendor";
      submitBtn.textContent = "Update Vendor";
      (document.getElementById("vf-id") as HTMLInputElement).value = vendor.id;
      (document.getElementById("vf-name") as HTMLInputElement).value = vendor.name || "";
      (document.getElementById("vf-contact") as HTMLInputElement).value = vendor.contact || "";
      (document.getElementById("vf-category") as HTMLInputElement).value = vendor.category || "";
      (document.getElementById("vf-phone") as HTMLInputElement).value = vendor.phone || "";
      (document.getElementById("vf-email") as HTMLInputElement).value = vendor.email || "";
      (document.getElementById("vf-address") as HTMLInputElement).value = vendor.address || "";
      (document.getElementById("vf-terms") as HTMLInputElement).value = vendor.paymentTerms || "";
      (document.getElementById("vf-notes") as HTMLTextAreaElement).value = vendor.notes || "";
    } else {
      title.textContent = "Add Vendor";
      submitBtn.textContent = "Create Vendor";
      (document.getElementById("vf-id") as HTMLInputElement).value = "";
      (document.getElementById("vendor-form") as HTMLFormElement).reset();
    }

    panel.classList.remove("hidden");
  }

  function closePanel() {
    panel.classList.add("hidden");
  }

  document.getElementById("show-add-form")?.addEventListener("click", () => openPanel());
  document.getElementById("close-panel")?.addEventListener("click", closePanel);
  document.getElementById("panel-backdrop")?.addEventListener("click", closePanel);
  document.getElementById("vf-cancel")?.addEventListener("click", closePanel);

  // Edit buttons
  document.querySelectorAll(".edit-vendor").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const id = (btn as HTMLElement).dataset.id;
      const vendor = vendorsData.find((v: any) => v.id === id);
      if (vendor) openPanel(vendor);
    });
  });

  // Row click to edit
  document.querySelectorAll(".vendor-row").forEach((row) => {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("button")) return;
      const id = (row as HTMLElement).dataset.id;
      const vendor = vendorsData.find((v: any) => v.id === id);
      if (vendor) openPanel(vendor);
    });
  });

  // Submit form (create or update)
  document.getElementById("vendor-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = (document.getElementById("vf-id") as HTMLInputElement).value;
    const isEdit = !!id;
    const msg = document.getElementById("vf-msg")!;

    const data: Record<string, string | null> = {
      name: (document.getElementById("vf-name") as HTMLInputElement).value,
      contact: (document.getElementById("vf-contact") as HTMLInputElement).value || null,
      category: (document.getElementById("vf-category") as HTMLInputElement).value || null,
      phone: (document.getElementById("vf-phone") as HTMLInputElement).value || null,
      email: (document.getElementById("vf-email") as HTMLInputElement).value || null,
      address: (document.getElementById("vf-address") as HTMLInputElement).value || null,
      paymentTerms: (document.getElementById("vf-terms") as HTMLInputElement).value || null,
      notes: (document.getElementById("vf-notes") as HTMLTextAreaElement).value || null,
    };

    const url = isEdit ? `/api/admin/inventory/vendors/${id}` : "/api/admin/inventory/vendors";
    const method = isEdit ? "PATCH" : "POST";

    const res = await fetch(url, {
      method,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json();
      msg.textContent = err.error || "Failed to save vendor";
      msg.className = "text-sm text-red-600";
      msg.classList.remove("hidden");
    }
  });

  // Delete buttons
  document.querySelectorAll(".delete-vendor").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      if (!confirm("Delete this vendor?")) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/inventory/vendors/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
    });
  });
</script>
